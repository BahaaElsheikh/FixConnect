@{
    ViewData["Title"] = "Email Confirmation";
    Layout = null;
    bool success = ViewBag.Success;
    string message = ViewBag.Message;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"] - FixConnect</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            theme: { extend: {
                "colors": { "primary-container": "#0052cc", "primary": "#003d9b", "background": "#faf9ff",
                    "on-surface": "#051a3e", "surface-container-lowest": "#ffffff", "outline-variant": "#c3c6d6",
                    "on-surface-variant": "#434654", "secondary-container": "#94f7b6", "secondary": "#006d3d",
                    "error-container": "#ffdad6", "error": "#ba1a1a" },
                "borderRadius": { "DEFAULT": "0.125rem", "lg": "0.25rem" },
                "spacing": { "sm": "8px", "xl": "48px", "lg": "24px", "md": "16px" },
                "fontFamily": { "h3": ["Manrope"], "body-md": ["Manrope"] },
                "fontSize": { "h3": ["24px", {"fontWeight": "600"}], "body-md": ["16px", {"fontWeight": "400"}] }
            }}
        }
    </script>
    <style>
        body {
            font-family: 'Manrope', sans-serif;
        }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
    </style>
</head>
<body class="bg-background text-on-background min-h-screen flex flex-col">
    <main class="flex-grow flex items-center justify-center px-lg py-xl">
        <div class="w-full max-w-[440px]">
            <div class="bg-surface-container-lowest border border-outline-variant rounded shadow-sm overflow-hidden p-lg md:p-xl text-center">
                @if (success)
                {
                    <div class="inline-flex items-center justify-center w-16 h-16 bg-secondary-container rounded-full mb-md">
                        <span class="material-symbols-outlined text-secondary text-[32px]">check_circle</span>
                    </div>
                    <h1 class="font-h3 text-h3 text-on-surface mb-xs">Email Confirmed!</h1>
                }
                else
                {
                    <div class="inline-flex items-center justify-center w-16 h-16 bg-error-container rounded-full mb-md">
                        <span class="material-symbols-outlined text-error text-[32px]">error</span>
                    </div>
                    <h1 class="font-h3 text-h3 text-on-surface mb-xs">Confirmation Failed</h1>
                }
                <p class="font-body-md text-on-surface-variant mb-xl">@message</p>
                <a asp-action="Login" class="w-full inline-block bg-primary-container hover:bg-primary text-white font-semibold py-4 px-lg rounded transition-colors">
                    Go to Login
                </a>
            </div>
        </div>
    </main>
</body>
</html>