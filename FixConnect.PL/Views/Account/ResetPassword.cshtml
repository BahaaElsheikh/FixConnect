@model FixConnect.PL.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"] - FixConnect</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "primary-container": "#0052cc", "primary": "#003d9b", "background": "#faf9ff",
                        "on-surface": "#051a3e", "surface-container-lowest": "#ffffff", "outline": "#737685",
                        "outline-variant": "#c3c6d6", "on-surface-variant": "#434654", "error": "#ba1a1a"
                    },
                    "borderRadius": { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
                    "spacing": { "sm": "8px", "xl": "48px", "lg": "24px", "xs": "4px", "md": "16px" },
                    "fontFamily": { "body-md": ["Manrope"], "h3": ["Manrope"], "label-sm": ["Manrope"] },
                    "fontSize": {
                        "body-md": ["16px", {"lineHeight": "1.5", "fontWeight": "400"}],
                        "h3": ["24px", {"lineHeight": "1.4", "fontWeight": "600"}],
                        "label-sm": ["13px", {"lineHeight": "1", "letterSpacing": "0.05em", "fontWeight": "600"}]
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Manrope', sans-serif;
        }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
    </style>
</head>
<body class="bg-background text-on-background min-h-screen flex flex-col">
    <main class="flex-grow flex items-center justify-center px-lg py-xl relative overflow-hidden">
        <div class="absolute inset-0 z-0 opacity-10">
            <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-primary-container rounded-full blur-[120px]"></div>
        </div>

        <div class="w-full max-w-[440px] z-10">
            <div class="bg-surface-container-lowest border border-outline-variant rounded shadow-sm overflow-hidden p-lg md:p-xl">

                @if (ViewBag.InvalidLink == true)
                {
                    <div class="text-center">
                        <span class="material-symbols-outlined text-error text-[48px] mb-md">error</span>
                        <h1 class="font-h3 text-h3 text-on-surface mb-xs">Invalid or Expired Link</h1>
                        <p class="font-body-md text-on-surface-variant mb-xl">This reset link is no longer valid. Please request a new one.</p>
                        <a asp-action="ForgotPassword" class="w-full inline-block bg-primary-container hover:bg-primary text-white font-semibold py-4 px-lg rounded transition-colors">
                            Request New Link
                        </a>
                    </div>
                }
                else
                {
                    <div class="text-center mb-xl">
                        <h1 class="font-h3 text-h3 text-on-surface mb-xs">Reset Your Password</h1>
                        <p class="font-body-md text-on-surface-variant">Enter a new password for your account</p>
                    </div>

                    <form asp-action="ResetPassword" class="space-y-lg" method="post">
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div asp-validation-summary="All" class="p-3 bg-red-50 border border-red-200 text-red-600 rounded text-sm mb-4"></div>
                        }

                        <input type="hidden" asp-for="UserId" />
                        <input type="hidden" asp-for="Token" />

                        <div class="space-y-xs">
                            <label class="font-label-sm text-label-sm text-outline uppercase tracking-wider" asp-for="NewPassword">New Password</label>
                            <div class="relative group">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline group-focus-within:text-primary transition-colors">lock</span>
                                <input asp-for="NewPassword" type="password" class="w-full pl-10 pr-4 py-3 bg-white border border-outline-variant rounded focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all font-body-md" placeholder="Enter new password" />
                            </div>
                            <span asp-validation-for="NewPassword" class="text-red-500 text-[11px]"></span>
                        </div>

                        <div class="space-y-xs">
                            <label class="font-label-sm text-label-sm text-outline uppercase tracking-wider" asp-for="ConfirmPassword">Confirm Password</label>
                            <div class="relative group">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline group-focus-within:text-primary transition-colors">lock</span>
                                <input asp-for="ConfirmPassword" type="password" class="w-full pl-10 pr-4 py-3 bg-white border border-outline-variant rounded focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all font-body-md" placeholder="Confirm new password" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-red-500 text-[11px]"></span>
                        </div>

                        <button class="w-full bg-primary-container hover:bg-primary text-white font-semibold py-4 px-lg rounded transition-colors flex items-center justify-center gap-sm active:scale-[0.98] duration-150" type="submit">
                            <span>Reset Password</span>
                            <span class="material-symbols-outlined text-[20px]">check_circle</span>
                        </button>
                    </form>
                }
            </div>
        </div>
    </main>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>