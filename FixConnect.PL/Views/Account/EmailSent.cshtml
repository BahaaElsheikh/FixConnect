@{
    ViewData["Title"] = "Check Your Email";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"] - FixConnect</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "secondary": "#006d3d", "primary-container": "#0052cc", "primary": "#003d9b",
                        "background": "#faf9ff", "on-surface": "#051a3e", "surface-container-lowest": "#ffffff",
                        "outline": "#737685", "outline-variant": "#c3c6d6", "on-surface-variant": "#434654",
                        "secondary-container": "#94f7b6", "on-secondary-container": "#007442"
                    },
                    "borderRadius": { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
                    "spacing": { "sm": "8px", "xl": "48px", "lg": "24px", "xs": "4px", "md": "16px" },
                    "fontFamily": { "body-md": ["Manrope"], "h3": ["Manrope"], "label-sm": ["Manrope"] },
                    "fontSize": {
                        "body-md": ["16px", {"lineHeight": "1.5", "fontWeight": "400"}],
                        "h3": ["24px", {"lineHeight": "1.4", "fontWeight": "600"}],
                        "label-sm": ["13px", {"lineHeight": "1", "letterSpacing": "0.05em", "fontWeight": "600"}]
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Manrope', sans-serif;
        }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
    </style>
</head>
<body class="bg-background text-on-background min-h-screen flex flex-col">
    <main class="flex-grow flex items-center justify-center px-lg py-xl relative overflow-hidden">
        <div class="absolute inset-0 z-0 opacity-10">
            <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-primary-container rounded-full blur-[120px]"></div>
        </div>

        <div class="w-full max-w-[440px] z-10">
            <div class="bg-surface-container-lowest border border-outline-variant rounded shadow-sm overflow-hidden p-lg md:p-xl text-center">
                <div class="inline-flex items-center justify-center w-16 h-16 bg-secondary-container rounded-full mb-md">
                    <span class="material-symbols-outlined text-secondary text-[32px]">mark_email_read</span>
                </div>
                <h1 class="font-h3 text-h3 text-on-surface mb-xs">Check Your Email</h1>
                <p class="font-body-md text-on-surface-variant mb-xl">
                    If an account exists with that email, we've sent a link to reset your password. It expires in 1 hour.
                </p>
                <a asp-action="Login" class="w-full inline-block bg-primary-container hover:bg-primary text-white font-semibold py-4 px-lg rounded transition-colors">
                    Back to Login
                </a>
            </div>
        </div>
    </main>
</body>
</html>