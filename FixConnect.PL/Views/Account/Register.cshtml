@model FixConnect.PL.ViewModels.RegisterViewModel
@using FixConnect.DAL.Data.Enums

@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"] - FixConnect</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "secondary": "#006d3d",
                        "secondary-fixed": "#94f7b6",
                        "primary-container": "#0052cc",
                        "surface-container-low": "#f1f3ff",
                        "inverse-primary": "#b2c5ff",
                        "on-secondary-fixed-variant": "#00522d",
                        "on-primary-fixed": "#001848",
                        "on-primary": "#ffffff",
                        "outline": "#737685",
                        "surface-dim": "#ccdaff",
                        "on-tertiary-fixed-variant": "#812800",
                        "background": "#faf9ff",
                        "primary": "#003d9b",
                        "surface-bright": "#faf9ff",
                        "on-surface": "#051a3e",
                        "on-error-container": "#93000a",
                        "surface-container-lowest": "#ffffff",
                        "surface-container": "#e9edff",
                        "surface-container-high": "#e1e8ff",
                        "tertiary-fixed": "#ffdbcf",
                        "inverse-on-surface": "#edf0ff",
                        "outline-variant": "#c3c6d6",
                        "error-container": "#ffdad6",
                        "on-error": "#ffffff",
                        "inverse-surface": "#1d3054",
                        "surface-tint": "#0c56d0",
                        "surface-container-highest": "#d8e2ff",
                        "on-tertiary": "#ffffff",
                        "surface": "#faf9ff",
                        "tertiary-container": "#a33500",
                        "primary-fixed": "#dae2ff",
                        "on-tertiary-container": "#ffc6b2",
                        "tertiary-fixed-dim": "#ffb59b",
                        "on-tertiary-fixed": "#380d00",
                        "secondary-container": "#94f7b6",
                        "primary-fixed-dim": "#b2c5ff",
                        "on-secondary-fixed": "#00210f",
                        "error": "#ba1a1a",
                        "on-primary-container": "#c4d2ff",
                        "on-background": "#051a3e",
                        "on-primary-fixed-variant": "#0040a2",
                        "on-secondary-container": "#007442",
                        "surface-variant": "#d8e2ff",
                        "on-surface-variant": "#434654",
                        "tertiary": "#7b2600",
                        "on-secondary": "#ffffff",
                        "secondary-fixed-dim": "#78da9c"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.125rem",
                        "lg": "0.25rem",
                        "xl": "0.5rem",
                        "full": "0.75rem"
                    },
                    "spacing": {
                        "sm": "8px",
                        "xl": "48px",
                        "lg": "24px",
                        "xs": "4px",
                        "max-width": "1200px",
                        "gutter": "24px",
                        "md": "16px",
                        "unit": "4px"
                    },
                    "fontFamily": {
                        "body-md": ["Manrope"],
                        "h2": ["Manrope"],
                        "h1": ["Manrope"],
                        "h3": ["Manrope"],
                        "label-sm": ["Manrope"],
                        "body-lg": ["Manrope"]
                    },
                    "fontSize": {
                        "body-md": ["16px", { "lineHeight": "1.5", "letterSpacing": "0", "fontWeight": "400" }],
                        "h2": ["32px", { "lineHeight": "1.3", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                        "h1": ["40px", { "lineHeight": "1.2", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "h3": ["24px", { "lineHeight": "1.4", "letterSpacing": "0", "fontWeight": "600" }],
                        "label-sm": ["13px", { "lineHeight": "1", "letterSpacing": "0.05em", "fontWeight": "600" }],
                        "body-lg": ["18px", { "lineHeight": "1.6", "letterSpacing": "0", "fontWeight": "400" }]
                    }
                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        .form-input-focus:focus {
            border-color: #0052CC;
            box-shadow: 0 0 0 1px #0052CC;
            outline: none;
        }
    </style>
</head>
<body class="bg-background font-body-md text-on-background min-h-screen flex flex-col">

    <!-- Header -->
    <header class="bg-white dark:bg-gray-950 text-[#0052CC] font-manrope antialiased text-sm docked full-width top-0 border-b border-gray-200 dark:border-gray-800 flat no shadows flex justify-between items-center w-full px-6 h-16 z-40">
        <div class="text-xl font-black text-[#0052CC] tracking-tighter">FixConnect</div>
        <div class="flex items-center gap-lg">
            <a class="text-gray-500 font-medium hover:text-[#0052CC] transition-colors cursor-pointer active:scale-95 duration-150" asp-action="Login">Login</a>
            <span class="material-symbols-outlined cursor-pointer" data-icon="help_outline">help_outline</span>
        </div>
    </header>

    <main class="flex-grow flex items-center justify-center py-xl px-lg">
        <div class="max-w-[1200px] w-full grid grid-cols-1 lg:grid-cols-12 gap-xl items-center">

            <!-- Branding Side -->
            <div class="hidden lg:flex lg:col-span-6 flex-col gap-lg pr-xl">
                <div class="h-64 rounded-xl overflow-hidden mb-lg">
                    <img class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAiObfAsXR8Dls0IXLjy1Savv8wsu7V9eBNW8MAl4NpMfV9Eyr263Gltt7Ux10HXRndSpXJ-9F_YksTCV8wSqs6BNRh3NSImpRuPcTmAk7wM5XWf7qzUsAr2s4QaXG2LEwhBhNNFrV3oy2U26hrEwGdCUNvj5f2W9QXFIJPSJeSba6DGQzI8RawGrwcjs0T7gT6oTl1gRhDtUEpOeqR1nNfIYWZMiklduR7RoWU-s659P9qTDbrM362_ReVPOrMdOZVjLDUv1fKYI8" />
                </div>
                <h1 class="font-h1 text-h1 text-on-surface">The precise toolbelt for your maintenance needs.</h1>
                <p class="font-body-lg text-body-lg text-outline">Join the network connecting skilled professionals with clients who value efficiency and clinical clarity.</p>
                <div class="grid grid-cols-2 gap-md mt-md">
                    <div class="p-lg border border-outline-variant rounded bg-white">
                        <span class="material-symbols-outlined text-[#0052CC] mb-sm">verified</span>
                        <h3 class="font-h3 text-body-md font-bold">Verified Pros</h3>
                        <p class="text-label-sm text-outline">Background checked workers.</p>
                    </div>
                    <div class="p-lg border border-outline-variant rounded bg-white">
                        <span class="material-symbols-outlined text-[#0052CC] mb-sm">speed</span>
                        <h3 class="font-h3 text-body-md font-bold">Fast Response</h3>
                        <p class="text-label-sm text-outline">Minutes, not hours.</p>
                    </div>
                </div>
            </div>

            <!-- Registration Form Card -->
            <div class="lg:col-span-6 flex justify-center lg:justify-end">
                <div class="bg-white border border-outline-variant p-xl rounded-lg w-full max-w-md shadow-sm">
                    <div class="mb-lg text-center lg:text-left">
                        <h2 class="font-h2 text-h2 text-on-surface mb-xs">Create Account</h2>
                        <p class="text-outline font-body-md">Register your FixConnect portal profile.</p>
                    </div>

                    <form asp-action="Register" class="flex flex-col gap-md" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm mb-2"></div>

                        <!-- Account Type Toggle -->
                        <div class="flex flex-col gap-sm mb-sm">
                            <span class="text-label-sm text-on-surface-variant uppercase tracking-wider">Account Type</span>
                            <div class="grid grid-cols-2 p-xs bg-surface-container rounded-lg border border-outline-variant">
                                <label class="cursor-pointer">
                                    <input asp-for="Role" value="@((int)RoleType.Customer)" class="sr-only peer role-toggle" type="radio" checked />
                                    <div class="text-center py-sm rounded peer-checked:bg-white peer-checked:text-[#0052CC] peer-checked:shadow-sm text-gray-500 font-medium transition-all">
                                        Customer
                                    </div>
                                </label>
                                <label class="cursor-pointer">
                                    <input asp-for="Role" value="@((int)RoleType.Worker)" class="sr-only peer role-toggle" type="radio" />
                                    <div class="text-center py-sm rounded peer-checked:bg-white peer-checked:text-[#0052CC] peer-checked:shadow-sm text-gray-500 font-medium transition-all">
                                        Worker
                                    </div>
                                </label>
                            </div>
                            <span asp-validation-for="Role" class="text-red-500 text-[11px]"></span>
                        </div>

                        <!-- Full Name -->
                        <div class="flex flex-col gap-xs">
                            <label class="text-label-sm text-on-surface-variant uppercase" asp-for="FullName">Full Name</label>
                            <input asp-for="FullName" class="w-full px-md py-sm border border-outline-variant rounded font-body-md form-input-focus transition-all" placeholder="e.g. Alex Johnson" />
                            <span asp-validation-for="FullName" class="text-red-500 text-[11px]"></span>
                        </div>

                        <!-- Email -->
                        <div class="flex flex-col gap-xs">
                            <label class="text-label-sm text-on-surface-variant uppercase" asp-for="Email">Email Address</label>
                            <input asp-for="Email" class="w-full px-md py-sm border border-outline-variant rounded font-body-md form-input-focus transition-all" placeholder="alex@example.com" />
                            <span asp-validation-for="Email" class="text-red-500 text-[11px]"></span>
                        </div>

                        <!-- Phone -->
                        <div class="flex flex-col gap-xs">
                            <label class="text-label-sm text-on-surface-variant uppercase" asp-for="Phone">Phone Number</label>
                            <input asp-for="Phone" class="w-full px-md py-sm border border-outline-variant rounded font-body-md form-input-focus transition-all" placeholder="01xxxxxxxxx" />
                            <span asp-validation-for="Phone" class="text-red-500 text-[11px]"></span>
                        </div>

                        <!-- Specialty (Visible only for Workers) -->
                        <div class="flex flex-col gap-xs hidden" id="specialtyGroup">
                            <label class="text-label-sm text-on-surface-variant uppercase" asp-for="Specialty">Specialty</label>
                            <input asp-for="Specialty" class="w-full px-md py-sm border border-outline-variant rounded font-body-md form-input-focus transition-all" placeholder="e.g. Plumbing, Electrical" />
                            <span asp-validation-for="Specialty" class="text-red-500 text-[11px]"></span>
                        </div>

                        <!-- Password -->
                        <div class="flex flex-col gap-xs">
                            <label class="text-label-sm text-on-surface-variant uppercase" asp-for="Password">Password</label>
                            <div class="relative">
                                <input asp-for="Password" type="password" id="passwordInput" class="w-full px-md py-sm border border-outline-variant rounded font-body-md form-input-focus transition-all" placeholder="Enter your password" />
                                <button type="button" onclick="togglePassword('passwordInput', 'eyeIcon1')" class="absolute inset-y-0 right-0 pr-3 flex items-center text-outline">
                                    <span id="eyeIcon1" class="material-symbols-outlined text-sm">visibility</span>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-red-500 text-[11px]"></span>
                        </div>

                        <!-- Confirm Password -->
                        <div class="flex flex-col gap-xs">
                            <label class="text-label-sm text-on-surface-variant uppercase" asp-for="ConfirmPassword">Confirm Password</label>
                            <div class="relative">
                                <input asp-for="ConfirmPassword" type="password" id="confirmPasswordInput" class="w-full px-md py-sm border border-outline-variant rounded font-body-md form-input-focus transition-all" placeholder="Repeat your password" />
                                <button type="button" onclick="togglePassword('confirmPasswordInput', 'eyeIcon2')" class="absolute inset-y-0 right-0 pr-3 flex items-center text-outline">
                                    <span id="eyeIcon2" class="material-symbols-outlined text-sm">visibility</span>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-red-500 text-[11px]"></span>
                        </div>

                        <!-- Submit Button -->
                        <button class="w-full bg-[#0052CC] text-white py-md rounded-lg font-bold hover:bg-[#003d9b] active:scale-[0.98] transition-all flex items-center justify-center gap-sm mt-md" type="submit">
                            Create Account
                            <span class="material-symbols-outlined text-sm">arrow_forward</span>
                        </button>
                    </form>

                    <div class="mt-lg pt-lg border-t border-outline-variant text-center">
                        <p class="text-label-sm text-outline">
                            Already have an account?
                            <a class="text-[#0052CC] font-bold hover:underline" asp-action="Login">Sign In</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-surface-container text-outline py-lg px-xl border-t border-outline-variant">
        <div class="max-w-[1200px] mx-auto flex flex-col md:flex-row justify-between items-center gap-md">
            <div class="flex items-center gap-sm">
                <span class="font-bold text-on-surface">FixConnect</span>
                <span class="text-label-sm">© 2026 Maintenance Portal</span>
            </div>
            <div class="flex gap-lg text-label-sm uppercase font-bold tracking-widest">
                <a class="hover:text-primary transition-colors" href="#">Support</a>
                <a class="hover:text-primary transition-colors" href="#">Privacy</a>
                <a class="hover:text-primary transition-colors" href="#">API</a>
            </div>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <partial name="_ValidationScriptsPartial" />

    <script>
        // اللوجيك الخاص بإظهار وإخفاء حقل التخصص بناءً على الـ Radio Button
        const workerValue = '@((int)RoleType.Worker)';
        const specialtyGroup = document.getElementById('specialtyGroup');
        const roleRadios = document.querySelectorAll('.role-toggle');

        roleRadios.forEach(radio => {
            radio.addEventListener('change', function() {
                if (this.value === workerValue) {
                    specialtyGroup.classList.remove('hidden');
                } else {
                    specialtyGroup.classList.add('hidden');
                }
            });
        });

        // عشان لو الصفحة حملت وكان الـ Worker هو اللي مختار (مثلا في حالة الـ Validation error)
        window.onload = function() {
            const selectedRole = document.querySelector('.role-toggle:checked');
            if (selectedRole && selectedRole.value === workerValue) {
                specialtyGroup.classList.remove('hidden');
            }
        };



                function togglePassword(inputId, iconId) {
            const passwordInput = document.getElementById(inputId);
            const eyeIcon = document.getElementById(iconId);

            if (passwordInput.type === "password") {
                passwordInput.type = "text";
                eyeIcon.innerText = "visibility_off"; // تغيير الأيقونة لعين عليها خط
            } else {
                passwordInput.type = "password";
                eyeIcon.innerText = "visibility"; // رجوع الأيقونة للعادية
            }
        }
    </script>
</body>
</html>