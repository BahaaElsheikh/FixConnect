@model FixConnect.PL.ViewModels.CompleteProfileViewModel
@using FixConnect.DAL.Data.Enums

@{
    ViewData["Title"] = "Complete Profile";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FixConnect — Complete Profile</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light d-flex align-items-center justify-content-center min-vh-100">

    <div class="card shadow-sm p-4" style="width:100%;max-width:480px">
        <h4 class="mb-1 fw-bold">Almost there!</h4>
        <p class="text-muted small mb-4">Complete your profile to continue.</p>

        <form asp-action="CompleteProfile" method="post">
           

            @* Hidden fields passed from Google *@
            <input type="hidden" asp-for="FullName" />
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="GoogleId" />

            <div class="mb-3">
                <label class="form-label">Full Name</label>
                <input class="form-control" value="@Model.FullName" disabled />
            </div>

            <div class="mb-3">
                <label class="form-label">Email</label>
                <input class="form-control" value="@Model.Email" disabled />
            </div>

            <div class="mb-3">
                <label asp-for="Phone" class="form-label">Phone Number</label>
                <input asp-for="Phone" class="form-control" placeholder="01xxxxxxxxx" />
                <span asp-validation-for="Phone" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Role" class="form-label">I am a</label>
                <select asp-for="Role" class="form-select" id="roleSelect">
                    <option value="">— Select Role —</option>
                    <option value="@((int)RoleType.Customer)">Customer</option>
                    <option value="@((int)RoleType.Worker)">Worker</option>
                </select>
                <span asp-validation-for="Role" class="text-danger small"></span>
            </div>

            <div class="mb-3 d-none" id="specialtyGroup">
                <label class="form-label">Specialty</label>
                <select name="SpecialtyId" class="form-select">
                    <option value="">— Select Specialty —</option>
                    @foreach (var s in Model.Specialties)
                    {
                        <option value="@s.SpecialtyId">@s.SpecialtyName</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-dark w-100">Complete Registration</button>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('roleSelect').addEventListener('change', function () {
            const workerValue = '@((int)RoleType.Worker)';
            document.getElementById('specialtyGroup')
                    .classList.toggle('d-none', this.value !== workerValue);
        });
    </script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>