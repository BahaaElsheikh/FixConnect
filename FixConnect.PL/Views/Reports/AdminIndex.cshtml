@model FixConnect.PL.ViewModels.ReportsListViewModel
@{
    ViewData["Title"] = "Report Operations Management";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">
    <h5 class="fw-bold mb-4">Report Operations Management</h5>

    <form method="get" asp-action="AdminIndex" class="d-flex gap-2 mb-4 flex-wrap align-items-center">

        <input type="text"
               name="search"
               value="@Model.SearchQuery"
               class="form-control"
               style="max-width:280px"
               placeholder="Search description, email..." />

        <input type="hidden" name="sortOrder" value="@Model.SortOrder" />
        <input type="hidden" name="categoryFilter" value="@Model.CategoryFilter" />

        <button type="submit" class="btn btn-outline-secondary">Search</button>

        <div class="d-flex gap-1 align-items-center ms-2">
            <span class="text-muted small me-1"><i class="bi bi-sort-down"></i> Logged Date:</span>

            <a asp-action="AdminIndex"
               asp-route-search="@Model.SearchQuery"
               asp-route-categoryFilter="@Model.CategoryFilter"
               asp-route-sortOrder="date_desc"
               class="btn btn-sm @(Model.SortOrder == "date_desc" ? "btn-primary" : "btn-outline-primary")">
                <i class="bi bi-arrow-down"></i> Newest
            </a>

            <a asp-action="AdminIndex"
               asp-route-search="@Model.SearchQuery"
               asp-route-categoryFilter="@Model.CategoryFilter"
               asp-route-sortOrder="date_asc"
               class="btn btn-sm @(Model.SortOrder == "date_asc" ? "btn-primary" : "btn-outline-primary")">
                <i class="bi bi-arrow-up"></i> Oldest
            </a>
        </div>

        <div class="ms-auto d-flex gap-2">
            <a asp-action="AdminIndex" asp-route-search="@Model.SearchQuery" asp-route-categoryFilter="" asp-route-sortOrder="@Model.SortOrder"
               class="btn @(string.IsNullOrEmpty(Model.CategoryFilter) ? "btn-dark" : "btn-outline-dark")">
                All Type Contexts
            </a>
            <a asp-action="AdminIndex" asp-route-search="@Model.SearchQuery" asp-route-categoryFilter="Job" asp-route-sortOrder="@Model.SortOrder"
               class="btn @(Model.CategoryFilter == "Job" ? "btn-dark" : "btn-outline-dark")">
                Jobs
            </a>
            <a asp-action="AdminIndex" asp-route-search="@Model.SearchQuery" asp-route-categoryFilter="Request" asp-route-sortOrder="@Model.SortOrder"
               class="btn @(Model.CategoryFilter == "Request" ? "btn-dark" : "btn-outline-dark")">
                Requests
            </a>
            <a asp-action="AdminIndex" asp-route-search="@Model.SearchQuery" asp-route-categoryFilter="Proposal" asp-route-sortOrder="@Model.SortOrder"
               class="btn @(Model.CategoryFilter == "Proposal" ? "btn-dark" : "btn-outline-dark")">
                Proposals
            </a>
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Reporter Individual</th>
                        <th>Reporter Email</th>
                        <th>Target Context Group</th>
                        <th>Associated Scope Reference ID</th>
                        <th>Detailed Log Statement Content</th>
                        <th>Timestamp Formatted</th>
                        <th>System Resolve State</th>
                        <th>Actions Framework</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var report in Model.Reports.Items)
                    {
                        <tr class="@(report.IsResolved ? "table-secondary text-muted" : "")">
                            <td class="small">@report.ReportId</td>
                            <td>
                                <span class="fw-semibold">@report.Reporter.FullName</span>
                            </td>
                            <td class="small">@report.Reporter.Email</td>
                            <td>
                                @{
                                    string badgeClass = report.JobId != null ? "bg-info text-dark" :
                                    report.RequestId != null ? "bg-warning text-dark" :
                                    report.ProposalId != null ? "bg-success" : "bg-secondary";
                                    string contextLabel = report.JobId != null ? "Job Instance" :
                                    report.RequestId != null ? "Request Model" :
                                    report.ProposalId != null ? "Proposal Data" : "Review Index";
                                }
                                <span class="badge @badgeClass">@contextLabel</span>
                            </td>
                            <td class="small fw-bold text-center">
                                @(report.JobId ?? report.RequestId ?? report.ProposalId ?? report.ReviewId)
                            </td>
                            <td class="small" style="max-width:250px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;" title="@report.Description">
                                @report.Description
                            </td>
                            <td class="small">@report.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                            <td>
                                <span class="badge @(report.IsResolved ? "bg-success" : "bg-danger")">
                                    @(report.IsResolved ? "Resolved" : "Active / Unresolved")
                                </span>
                            </td>
                            <td>
                                <div class="d-flex gap-1 flex-wrap">
                                    <form asp-action="ToggleResolve" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="reportId" value="@report.ReportId" />
                                        <input type="hidden" name="currentStatus" value="@report.IsResolved.ToString().ToLower()" />
                                        <input type="hidden" name="search" value="@Model.SearchQuery" />
                                        <input type="hidden" name="categoryFilter" value="@Model.CategoryFilter" />
                                        <input type="hidden" name="sortOrder" value="@Model.SortOrder" />

                                        <button type="submit"
                                                class="btn btn-sm @(report.IsResolved ? "btn-outline-warning" : "btn-outline-success")"
                                                onclick="return confirm('Change state processing flag for instance #@report.ReportId?')">
                                            @(report.IsResolved ? "Reopen Claim" : "Mark Resolved")
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }

                    @if (!Model.Reports.Items.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">No validation infraction claims logged matching current matrix metrics.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="px-3 pb-3 mt-3">
        <partial name="_Pagination" model="Model.Reports" />
    </div>
</div>