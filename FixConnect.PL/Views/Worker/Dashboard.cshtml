@model FixConnect.PL.ViewModels.WorkerDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_WorkerLayout";
}

<div class="flex-1 p-gutter md:p-container-margin max-w-7xl mx-auto w-full pt-6">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-stack-lg gap-4">
        <div>
            <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface">Available Requests</h2>
            <p class="font-body-md text-body-md text-on-surface-variant mt-2">Browse and apply to public jobs matching your skills.</p>
        </div>
    </div>

    <form method="get" asp-action="Dashboard" class="bg-surface-container-lowest border border-outline-variant/30 rounded-xl p-4 shadow-[0_4px_20px_rgba(0,62,199,0.04)] mb-stack-lg flex flex-col md:flex-row gap-4 mb-8">
        <div class="flex-1 relative">
            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline">search</span>
            <input name="search" value="@Model.SearchQuery" class="w-full pl-12 pr-4 py-3 bg-[#F1F5F9] border-transparent focus:bg-white focus:border-primary focus:ring-1 focus:ring-primary rounded-xl font-body-md text-body-md text-on-surface placeholder:text-outline transition-all outline-none" placeholder="Search by title or description..." type="text" />
        </div>

        <div class="flex gap-4 flex-1 md:flex-none">
            <div class="relative flex-1 md:w-64">
                <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline">location_on</span>
                <input type="text" id="regionSearchInput" name="regionSearch" value="@Model.RegionSearch" class="w-full pl-12 pr-4 py-3 bg-[#F1F5F9] border-transparent focus:bg-white focus:border-primary focus:ring-1 focus:ring-primary rounded-xl font-body-md text-body-md text-on-surface placeholder:text-outline transition-all outline-none" placeholder="Filter by region..." autocomplete="off" />

                <div id="regionDropdown" class="absolute top-[110%] left-0 right-0 bg-white border border-outline-variant/30 rounded-xl shadow-lg z-[999] hidden max-h-48 overflow-y-auto">
                </div>
            </div>
            <button type="submit" class="px-6 py-3 bg-primary text-white rounded-xl font-label-md text-label-md hover:shadow-lg hover:shadow-primary/20 transition-all font-semibold">
                Search
            </button>
        </div>
    </form>

    <div class="flex flex-col lg:flex-row gap-8">

        <div class="flex-1">
            @if (!Model.PublicRequests.Any())
            {
                <div class="text-center py-16 bg-surface-container-lowest border border-slate-200 rounded-xl shadow-sm">
                    <span class="text-6xl mb-4 block">📭</span>
                    <p class="text-on-surface-variant font-body-md text-body-md">No public requests available right now.</p>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-start">
                    @foreach (var r in Model.PublicRequests)
                    {
                        <div class="bg-surface-container-lowest border border-slate-200 rounded-xl p-6 shadow-[0_4px_20px_rgba(0,62,199,0.04)] hover:shadow-[0_8px_30px_rgba(0,62,199,0.08)] hover:-translate-y-1 transition-all duration-300 flex flex-col h-full">
                            <div class="flex justify-between items-start mb-4 gap-2 flex-wrap">
                                <div class="flex gap-2 flex-wrap">
                                    @if (!string.IsNullOrEmpty(r.SpecialtyName))
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-primary-container/20 text-primary">@r.SpecialtyName</span>
                                    }
                                    @if (r.AlreadyBid)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-700 border border-green-200">✔ Bid Sent</span>
                                    }
                                </div>
                                <span class="font-caption text-caption text-outline whitespace-nowrap">@r.CreatedAt.ToString("dd MMM yyyy")</span>
                            </div>

                            <h3 class="font-headline-md text-headline-md text-on-surface mb-2 line-clamp-2 font-bold break-words">@r.Title</h3>

                            <p class="text-sm text-secondary mb-4 line-clamp-3 flex-1 text-gray-600 break-words">@r.Description</p>

                            @if (r.ImagePaths.Any())
                            {
                                <div class="flex gap-2 flex-wrap mb-4">
                                    @foreach (var img in r.ImagePaths)
                                    {
                                        <img src="@img" onclick="openImg('@img')" class="w-16 h-16 object-cover rounded-lg border border-slate-200 bg-surface cursor-pointer hover:scale-105 transition-transform" />
                                    }
                                </div>
                            }

                            <div class="space-y-2 mb-6 mt-auto">
                                <div class="flex items-center gap-2 text-on-surface-variant font-body-md text-body-md">
                                    <span class="material-symbols-outlined text-xl text-gray-500">location_on</span>
                                    <span class="text-gray-700">@r.RegionName</span>
                                </div>
                                <div class="flex items-center gap-2 text-on-surface-variant font-body-md text-body-md">
                                    <span class="material-symbols-outlined text-xl text-gray-500">person</span>
                                    <span class="text-gray-700">@r.CustomerName</span>
                                </div>
                            </div>

                            <a asp-action="RequestDetail" asp-route-id="@r.RequestId" class="block text-center w-full py-3 px-4 bg-gradient-to-r from-[#003ec7] to-[#004ced] text-white rounded-xl font-label-md text-label-md hover:shadow-lg hover:shadow-primary/20 transition-all font-semibold">
                                View Details
                            </a>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="w-full lg:w-80 flex-shrink-0 space-y-6">
            <div class="bg-surface-container-lowest border border-slate-200 rounded-xl p-5 shadow-sm">
                <h6 class="text-xs font-bold uppercase tracking-wider text-secondary mb-4 text-gray-500">⚡ Latest Job</h6>
                @if (Model.LatestJob != null)
                {
                    <div class="bg-surface rounded-lg p-4 border border-outline-variant/20 bg-gray-50">
                        <div class="font-semibold text-sm mb-1 text-on-surface break-words">@Model.LatestJob.RequestTitle</div>
                        <div class="flex items-center gap-2 text-xs text-secondary mb-2 text-gray-600 break-words">
                            <span class="w-2 h-2 rounded-full @(Model.LatestJob.Status == "Active" ? "bg-green-600" : "bg-[#b45309]")"></span>
                            @Model.LatestJob.Status — @Model.LatestJob.CustomerName
                        </div>
                        <div class="text-xs text-secondary font-medium mb-3 text-gray-700">
                            💰 @Model.LatestJob.LiveInvoiceTotal.ToString("0.00") EGP
                        </div>
                        <a asp-action="JobDetail" asp-route-id="@Model.LatestJob.JobId" class="text-sm font-semibold text-[#003ec7] hover:underline">
                            View Job →
                        </a>
                    </div>
                }
                else
                {
                    <div class="text-sm text-secondary text-center py-2 text-gray-500">No active jobs.</div>
                }
            </div>

            <div class="bg-surface-container-lowest border border-slate-200 rounded-xl p-5 shadow-sm">
                <h6 class="text-xs font-bold uppercase tracking-wider text-secondary mb-4 text-gray-500">📩 Latest Direct Request</h6>
                @if (Model.LatestDirectRequest != null)
                {
                    <div class="bg-surface rounded-lg p-4 border border-outline-variant/20 bg-gray-50">
                        <div class="font-semibold text-sm mb-1 text-on-surface">@Model.LatestDirectRequest.Title</div>
                        <div class="flex items-center gap-2 text-xs text-secondary mb-1 text-gray-600">
                            <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
                            @Model.LatestDirectRequest.CustomerName
                        </div>
                        <div class="text-xs text-secondary mb-3 text-gray-600">
                            📍 @Model.LatestDirectRequest.RegionName
                        </div>
                        <a asp-action="RequestDetail" asp-route-id="@Model.LatestDirectRequest.RequestId" class="text-sm font-semibold text-[#003ec7] hover:underline">
                            View Request →
                        </a>
                    </div>
                }
                else
                {
                    <div class="text-sm text-secondary text-center py-2 text-gray-500">No direct requests.</div>
                }
            </div>
        </div>
    </div>
</div>

<div id="imgModal" class="fixed inset-0 z-[100] hidden bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 transition-opacity opacity-0" onclick="closeImg(event)">
    <div class="bg-white rounded-xl shadow-2xl p-2 max-w-4xl max-h-[90vh] overflow-hidden relative" onclick="event.stopPropagation()">
        <button onclick="closeImg(event)" class="absolute top-4 right-4 bg-black/50 text-white rounded-full p-1 hover:bg-black transition-colors">
            <span class="material-symbols-outlined">close</span>
        </button>
        <img id="imgSrc" src="" class="w-full h-full max-h-[80vh] object-contain rounded-lg" />
    </div>
</div>

<script>
    function openImg(src) {
        const modal = document.getElementById('imgModal');
        document.getElementById('imgSrc').src = src;
        modal.classList.remove('hidden');
        setTimeout(() => {
            modal.classList.remove('opacity-0');
            modal.classList.add('opacity-100');
        }, 10);
    }

    function closeImg(e) {
        const modal = document.getElementById('imgModal');
        modal.classList.remove('opacity-100');
        modal.classList.add('opacity-0');
        setTimeout(() => {
            modal.classList.add('hidden');
            document.getElementById('imgSrc').src = '';
        }, 300);
    }

    const regionInput = document.getElementById('regionSearchInput');
    const regionDropdown = document.getElementById('regionDropdown');

    const allRegions = [
        @foreach (var r in Model.Regions)
        {
                <text>{ name: "@Html.Raw(r.RegionName)" },</text>
        }
    ];

    regionInput.addEventListener('input', function () {
        const query = this.value.trim().toLowerCase();
        regionDropdown.innerHTML = '';

        if (query.length < 1) {
            regionDropdown.classList.add('hidden');
            return;
        }

        const filtered = allRegions.filter(r =>
            r.name.toLowerCase().includes(query));

        if (filtered.length === 0) {
            regionDropdown.classList.add('hidden');
            return;
        }

        filtered.forEach(r => {
            const item = document.createElement('div');
            item.textContent = r.name;
            item.className = 'px-4 py-3 text-sm text-on-surface cursor-pointer hover:bg-surface-container-high transition-colors border-b border-outline-variant/10 last:border-0';

            item.addEventListener('click', () => {
                regionInput.value = r.name;
                regionDropdown.classList.add('hidden');
                regionInput.closest('form').submit();
            });
            regionDropdown.appendChild(item);
        });

        regionDropdown.classList.remove('hidden');
    });

    document.addEventListener('click', function (e) {
        if (!regionDropdown.contains(e.target) && e.target !== regionInput) {
            regionDropdown.classList.add('hidden');
        }
    });
</script>