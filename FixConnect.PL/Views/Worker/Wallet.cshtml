@model FixConnect.PL.ViewModels.WalletViewModel
@{
    ViewData["Title"] = "My Wallet";
    Layout = "_WorkerLayout";
}

<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
<script id="tailwind-config">
    tailwind.config = {
        darkMode: "class",
        theme: {
            extend: {
                "colors": {
                    "surface-container": "#eceef0",
                    "surface-container-low": "#f2f4f6",
                    "surface-container-lowest": "#ffffff",
                    "surface-container-high": "#e6e8ea",
                    "on-surface": "#191c1e",
                    "secondary": "#5d5e62",
                    "primary": "#003ec7",
                    "primary-container": "#0052ff",
                    "on-primary-container": "#dfe3ff",
                    "outline-variant": "#c3c5d9",
                    "tertiary": "#3f4f65",
                    "background": "#f7f9fb",
                },
                "fontFamily": {
                    "caption": ["Plus Jakarta Sans"],
                    "body-md": ["Plus Jakarta Sans"],
                    "label-md": ["Plus Jakarta Sans"],
                    "headline-md": ["Plus Jakarta Sans"],
                    "display-xl": ["Plus Jakarta Sans"],
                    "headline-lg": ["Plus Jakarta Sans"]
                }
            }
        }
    }
</script>
<style>
    .glass-panel {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(226, 232, 240, 0.5);
        box-shadow: 0 4px 20px rgba(0, 62, 199, 0.04);
    }

    .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }
</style>

<main class="w-full max-w-[1440px] mx-auto p-4 md:p-8">

    <div class="mb-8 hidden md:block">
        <h2 class="font-headline-lg text-[32px] font-bold text-on-surface tracking-tight">Wallet Overview</h2>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="mb-6 p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl font-body-md flex items-center gap-2 shadow-sm">
            <span class="material-symbols-outlined text-emerald-600">check_circle</span>
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mb-6 p-4 bg-red-50 border border-red-200 text-red-800 rounded-xl font-body-md flex items-center gap-2 shadow-sm">
            <span class="material-symbols-outlined text-red-600">error</span>
            @TempData["Error"]
        </div>
    }

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">

        <div class="glass-panel rounded-[16px] p-6 col-span-1 md:col-span-2 relative overflow-hidden flex flex-col justify-between">
            <div class="absolute -right-10 -top-10 w-64 h-64 bg-primary/5 rounded-full blur-3xl pointer-events-none"></div>
            <div>
                <p class="font-label-md text-[14px] font-semibold text-secondary uppercase tracking-wider mb-2">Available Balance</p>
                <h3 class="font-display-xl text-[48px] font-extrabold mb-1 @(Model.Balance >= 0 ? "text-on-surface" : "text-red-500")">
                    @Model.Balance.ToString("0.00") EGP
                </h3>

                @if (Model.Balance < 0)
                {
                    <p class="font-caption text-[12px] font-medium text-red-600 bg-red-100/50 inline-flex items-center gap-1 px-2 py-1 rounded-md mt-2">
                        <span class="material-symbols-outlined text-[14px]">warning</span>
                        Negative balance — please recharge.
                    </p>
                }
                else
                {
                    <p class="font-caption text-[12px] font-medium text-emerald-600 bg-emerald-100/50 inline-block px-2 py-1 rounded-md">Ready to transfer</p>
                }
            </div>

            <div class="mt-8 flex gap-4">
                <button onclick="document.getElementById('rechargeModal').classList.remove('hidden')"
                        class="bg-gradient-to-r from-primary to-[#00d4ff] text-white px-6 py-3 rounded-xl font-label-md text-[14px] font-semibold shadow-[0_4px_14px_rgba(0,62,199,0.3)] hover:shadow-[0_6px_20px_rgba(0,62,199,0.4)] transition-all active:scale-95 flex items-center gap-2">
                    <span class="material-symbols-outlined text-[20px]">account_balance_wallet</span>
                    Recharge Wallet
                </button>
            </div>
        </div>

        <div class="flex flex-col gap-6">
            <div class="glass-panel rounded-[16px] p-6 flex-1 flex flex-col justify-center">
                <div class="flex items-center gap-2 mb-2">
                    <span class="material-symbols-outlined text-amber-500 text-[20px]">schedule</span>
                    <p class="font-label-md text-[14px] font-semibold text-secondary uppercase tracking-wider">Pending Payouts</p>
                </div>
                <h4 class="font-headline-md text-[24px] font-bold text-on-surface">
                    EGP @Model.PendingPayouts.ToString("N2")
                </h4>
                <p class="font-caption text-[12px] font-medium text-secondary mt-1">Clearing in 2-3 days</p>
            </div>

            <div class="glass-panel rounded-[16px] p-6 flex-1 flex flex-col justify-center">
                <div class="flex items-center gap-2 mb-2">
                    <span class="material-symbols-outlined text-primary text-[20px]">trending_up</span>
                    <p class="font-label-md text-[14px] font-semibold text-secondary uppercase tracking-wider">Total Earnings (YTD)</p>
                </div>
                <h4 class="font-headline-md text-[24px] font-bold text-on-surface">
                    EGP @Model.TotalEarnings.ToString("N2")
                </h4>
            </div>
        </div>
    </div>

    <div class="glass-panel rounded-[16px] overflow-hidden">
        <div class="p-6 border-b border-outline-variant/30 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <h3 class="font-headline-md text-[24px] font-bold text-on-surface">Transaction History</h3>

            <div class="flex gap-3">
                <div class="relative hidden sm:block">
                    <input class="w-full sm:w-48 h-10 pl-10 pr-4 bg-surface-container-low border-transparent focus:border-primary focus:bg-white rounded-lg font-body-md text-[16px] text-on-surface placeholder:text-secondary/70 transition-colors outline-none" placeholder="Search..." type="text" />
                    <span class="material-symbols-outlined absolute left-3 top-2.5 text-secondary text-[20px]">search</span>
                </div>
                <button class="h-10 px-4 flex items-center gap-2 bg-transparent border-[1.5px] border-tertiary text-tertiary rounded-lg font-label-md text-[14px] font-semibold hover:bg-surface-container-low transition-colors">
                    <span class="material-symbols-outlined text-[18px]">filter_list</span> Filter
                </button>
            </div>
        </div>

        <div class="divide-y divide-outline-variant/20">
            @if (!Model.Transactions.Any())
            {
                <div class="p-8 text-center text-secondary font-body-md text-[16px]">
                    <div class="w-16 h-16 bg-surface-container-low rounded-full flex items-center justify-center mx-auto mb-3">
                        <span class="material-symbols-outlined text-[32px] text-outline-variant">receipt_long</span>
                    </div>
                    No transactions yet.
                </div>
            }
            else
            {
                @foreach (var t in Model.Transactions)
                {
                    bool isCredit = t.Type == "Credit";

                    <div class="p-6 flex items-center justify-between hover:bg-surface-container-low/50 transition-colors group">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 rounded-full flex items-center justify-center group-hover:scale-105 transition-transform @(isCredit ? "bg-emerald-100 text-emerald-600" : "bg-surface-container-high text-tertiary")">
                                <span class="material-symbols-outlined">
                                    @(isCredit ? "arrow_downward" : "account_balance")
                                </span>
                            </div>
                            <div>
                                <h5 class="font-body-md text-[16px] font-semibold text-on-surface">
                                    Wallet @(isCredit ? "Deposit" : "Withdrawal")
                                </h5>
                                <p class="font-caption text-[12px] font-medium text-secondary mt-0.5">
                                    @t.CreatedAt.ToString("dd MMM yyyy, hh:mm tt") • Ref: #@t.TransactionId
                                </p>
                            </div>
                        </div>
                        <div class="text-right">
                            <p class="font-body-md text-[16px] font-bold @(isCredit ? "text-emerald-600" : "text-on-surface")">
                                @(isCredit ? "+" : "-") EGP @t.Amount.ToString("0.00")
                            </p>
                            <span class="inline-block mt-1 font-caption text-[12px] font-medium px-2 py-0.5 rounded-md @(isCredit ? "text-emerald-700 bg-emerald-100/50" : "text-secondary bg-surface-container-high")">
                                Completed
                            </span>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</main>

<div id="rechargeModal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 transition-opacity duration-300" onclick="document.getElementById('rechargeModal').classList.add('hidden')">
    <div class="relative w-full max-w-md bg-surface-container-lowest rounded-2xl shadow-2xl p-6 transform transition-transform" onclick="event.stopPropagation()">

        <form asp-action="Recharge" method="post">
            <div class="flex justify-between items-center mb-6 border-b border-outline-variant/30 pb-4">
                <h6 class="font-headline-md text-[20px] font-bold text-on-surface flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">credit_card</span> Recharge Wallet
                </h6>
                <button type="button" class="text-secondary hover:text-on-surface transition-colors" onclick="document.getElementById('rechargeModal').classList.add('hidden')">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <div class="mb-4">
                <label class="block font-label-md text-[14px] font-semibold text-on-surface mb-2">Amount (EGP)</label>
                <input name="Amount" type="number" min="1" step="0.01" class="w-full h-11 px-4 bg-background border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all font-body-md text-[16px] outline-none" placeholder="0.00" required />
            </div>

            <div class="mb-6">
                <label class="block font-label-md text-[14px] font-semibold text-on-surface mb-2">Payment Method</label>
                <div class="relative">
                    <select name="PaymentMethod" class="w-full h-11 px-4 appearance-none bg-background border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all font-body-md text-[16px] outline-none" required>
                        <option value="">— Select —</option>
                        <option value="Vodafone Cash">📱 Vodafone Cash</option>
                        <option value="Instapay">🏦 Instapay</option>
                        <option value="Credit Card">💳 Credit Card</option>
                    </select>
                    <span class="material-symbols-outlined absolute right-3 top-2.5 text-secondary pointer-events-none">expand_more</span>
                </div>
            </div>

            <div class="mb-6 p-3 bg-amber-50 border border-amber-200 text-amber-800 rounded-lg font-caption text-[12px] font-medium flex items-start gap-2">
                <span class="material-symbols-outlined text-[16px] mt-0.5">warning</span>
                <p>Payment integration coming soon. This will record the transaction only.</p>
            </div>

            <div class="flex gap-3 justify-end pt-4 border-t border-outline-variant/30">
                <button type="button" class="px-5 py-2.5 rounded-lg border border-outline-variant text-on-surface font-label-md text-[14px] font-semibold hover:bg-surface-container-low transition-colors" onclick="document.getElementById('rechargeModal').classList.add('hidden')">
                    Cancel
                </button>
                <button type="submit" class="px-5 py-2.5 rounded-lg bg-on-surface text-surface-container-lowest font-label-md text-[14px] font-semibold hover:bg-on-surface/90 transition-colors shadow-md">
                    Confirm Recharge
                </button>
            </div>
        </form>

    </div>
</div>