@model FixConnect.PL.ViewModels.ReceivedProposalsViewModel
@{
    ViewData["Title"] = "Proposals";
    Layout = "_CustomerLayout";
}

<div class="container py-4">
    <div class="d-flex align-items-center gap-2 mb-4">
        <a asp-action="MyRequests" class="btn btn-outline-secondary btn-sm">← Back</a>
        <h5 class="fw-bold mb-0">Proposals for: @ViewBag.RequestTitle</h5>
    </div>

    @if (!Model.Proposals.Any())
    {
        <div class="text-center text-muted py-5">No proposals yet.</div>
    }
    else
    {
        @foreach (var p in Model.Proposals)
        {
            <div class="card shadow-sm mb-4 p-4">
                <div class="row g-3">

                    <!-- Worker Info -->
                    <div class="col-md-3 text-center">
                        <img src="@(p.WorkerPhoto ?? "/uploads/ProfilePictures/default.png")"
                             class="rounded-circle mb-2"
                             style="width:80px;height:80px;object-fit:cover;" />
                        <h6 class="fw-bold mb-0">
                            @p.WorkerName
                            @if (p.WorkerIsVerified)
                            {
                                <span class="badge bg-primary" style="font-size:0.6rem">✔</span>
                            }
                        </h6>
                        <p class="text-muted small mb-1">@p.WorkerSpecialty</p>
                        <div class="mb-2">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <span style="color:@(i <= (int)p.WorkerRating ? "#f5a623" : "#ccc")">★</span>
                            }
                    </div>
                    <a asp-action="WorkerProfile" asp-route-id="@p.WorkerId"
                       class="btn btn-outline-secondary btn-sm w-100">
                        View Profile
                    </a>
                </div>

                <!-- Proposal Info -->
                <div class="col-md-4">
                    <p class="small mb-1">💰 Labor: <strong>@(p.LaborCost?.ToString("0.00") ?? "—") EGP</strong></p>
                    <p class="small mb-1">🔩 Material: <strong>@(p.MaterialCost?.ToString("0.00") ?? "—") EGP</strong></p>
                    <p class="small mb-1">📅 Duration: <strong>@(p.DurationEstimate.HasValue ? $"{p.DurationEstimate} days" : "—")</strong></p>
                    <p class="small mb-1">
                        🕐 Est. Start:
                        <strong>
                            @(p.EstimatedStartTime.HasValue
                                                    ? p.EstimatedStartTime.Value.ToString("dd MMM yyyy, hh:mm tt")
                                                    : "—")
                    </strong>
                </p>
                @if (!string.IsNullOrEmpty(p.Notes))
                        {
                            <p class="small mb-1">📝 <strong>@p.Notes</strong></p>
                        }
                        <span class="badge @(p.Status == "Pending"  ? "bg-warning text-dark" :
                                                                           p.Status == "Accepted" ? "bg-success" :
                                                                           p.Status == "Rejected" ? "bg-danger" :
                                                                                                     "bg-secondary")">
                    @p.Status
                </span>
            </div>

                    <!-- Portfolio -->
                    <div class="col-md-5">
                @if (p.Portfolio.Any())
                        {
                            <p class="small fw-semibold mb-1">Portfolio</p>
                            <div class="d-flex gap-1 flex-wrap mb-2">
                                @foreach (var item in p.Portfolio.Take(3))
                                {
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl"
                                             style="width:55px;height:55px;object-fit:cover;border-radius:4px;" />
                                    }
                                }
                            </div>
                        }
                        @if (p.Reviews.Any())
                        {
                            <p class="small fw-semibold mb-1">Latest Review</p>
                            var rev = p.Reviews.First();
                            <p class="small text-muted mb-0">"@rev.Comment" — @rev.CustomerName</p>
                        }
                    </div>

                    <!-- Actions -->
                    <div class="col-12 d-flex gap-2 justify-content-end border-top pt-3">
                        @if (p.Status == "Pending")
                        {
                            <a asp-action="AcceptProposal"
                               asp-route-proposalId="@p.ProposalId"
                               class="btn btn-success btn-sm">
                                ✔ Accept
                            </a>
                        }
                    </div>

                </div>
            </div>
        }
    }
</div>