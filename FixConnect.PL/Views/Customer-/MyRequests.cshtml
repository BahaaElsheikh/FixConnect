@model FixConnect.PL.ViewModels.MyRequestsViewModel
@{
    ViewData["Title"] = "My Requests";
    Layout = "_CustomerLayout";
}
@* <partial name="_CustomerNav" /> *@

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="fw-bold mb-0">My Requests</h5>
        <a asp-action="CreateRequest" class="btn btn-dark btn-sm">+ New Request</a>
    </div>

    @if (!Model.Requests.Any())
    {
        <div class="text-center text-muted py-5">No requests yet.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var r in Model.Requests)
            {
                <div class="col-md-6">
                    <div class="card shadow-sm p-3 h-100">
                        <div class="d-flex justify-content-between mb-1">
                            <h6 class="fw-bold mb-0">@r.Title</h6>
                            <span class="badge @(r.Status == "Pending" ? "bg-warning text-dark" :
                                                                                   r.Status == "InProgress" ? "bg-info text-dark" :
                                                                                   r.Status == "Completed" ? "bg-success" : "bg-secondary")">
                        @r.Status
                    </span>
                </div>
                <p class="text-muted small mb-1">@r.Description</p>
                <div class="d-flex gap-2 flex-wrap mb-2">
                    <span class="badge bg-light text-dark border">@r.RegionName</span>
                    @if (!string.IsNullOrEmpty(r.SpecialtyName))
                            {
                                <span class="badge bg-light text-dark border">@r.SpecialtyName</span>
                            }
                            <span class="badge bg-light text-dark border">@r.RequestType</span>
                        </div>

                        @if (r.ImagePaths.Any())
                        {
                            <div class="d-flex gap-1 mb-2">
                                @foreach (var img in r.ImagePaths.Take(3))
                                {
                                    <img src="@img" style="width:50px;height:50px;object-fit:cover;border-radius:4px;" />
                                }
                            </div>
                        }

                        <div class="d-flex justify-content-between align-items-center mt-auto">
                            <small class="text-muted">@r.CreatedAt.ToString("dd MMM yyyy")</small>
                            <div class="d-flex gap-1">

                                <!-- Proposals Count Button -->
                                <a asp-action="RequestProposals"
                                   asp-route-requestId="@r.RequestId"
                                   class="btn btn-sm btn-dark">
                                    📨 @r.ProposalCount proposals
                                </a>

                                <!-- Edit Button -->
                                <a asp-action="EditRequest" asp-route-id="@r.RequestId"
                                   class="btn btn-outline-secondary btn-sm">Edit</a>

                                <!-- Delete Button -->
                                <form asp-action="DeleteRequest" method="post"
                                      onsubmit="return confirm('Delete this request?')">
                                    <input type="hidden" name="requestId" value="@r.RequestId" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm">🗑</button>
                                </form>

                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>