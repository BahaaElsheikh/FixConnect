@model FixConnect.PL.ViewModels.UsersListViewModel
@{
    ViewData["Title"] = "User Management";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">
    <h5 class="fw-bold mb-4">User Management</h5>

    <form method="get" asp-action="Users" class="d-flex gap-2 mb-4 flex-wrap align-items-center">

        <input type="text"
               name="search"
               value="@Model.SearchQuery"
               class="form-control"
               style="max-width:280px"
               placeholder="Search name, email, phone..." />

        <input type="hidden" name="sortOrder" value="@Model.SortOrder" />
        <input type="hidden" name="roleFilter" value="@Model.RoleFilter" />

        <button type="submit" class="btn btn-outline-secondary">Search</button>

        <div class="d-flex gap-1 align-items-center ms-2">
            <span class="text-muted small me-1"><i class="bi bi-sort-down"></i> Joined Date:</span>

            <a asp-action="Users"
               asp-route-search="@Model.SearchQuery"
               asp-route-roleFilter="@Model.RoleFilter"
               asp-route-sortOrder="date_desc"
               class="btn btn-sm @(Model.SortOrder == "date_desc" ? "btn-primary" : "btn-outline-primary")">
                <i class="bi bi-arrow-down"></i> Newest
            </a>

            <a asp-action="Users"
               asp-route-search="@Model.SearchQuery"
               asp-route-roleFilter="@Model.RoleFilter"
               asp-route-sortOrder="date_asc"
               class="btn btn-sm @(Model.SortOrder == "date_asc" ? "btn-primary" : "btn-outline-primary")">
                <i class="bi bi-arrow-up"></i> Oldest
            </a>
        </div>

        <div class="ms-auto d-flex gap-2">
            <a asp-action="Users" asp-route-search="@Model.SearchQuery" asp-route-roleFilter="" asp-route-sortOrder="@Model.SortOrder"
               class="btn @(string.IsNullOrEmpty(Model.RoleFilter) ? "btn-dark" : "btn-outline-dark")">
                All
            </a>
            <a asp-action="Users" asp-route-search="@Model.SearchQuery" asp-route-roleFilter="Worker" asp-route-sortOrder="@Model.SortOrder"
               class="btn @(Model.RoleFilter == "Worker" ? "btn-dark" : "btn-outline-dark")">
                Workers
            </a>
            <a asp-action="Users" asp-route-search="@Model.SearchQuery" asp-route-roleFilter="Customer" asp-route-sortOrder="@Model.SortOrder"
               class="btn @(Model.RoleFilter == "Customer" ? "btn-dark" : "btn-outline-dark")">
                Customers
            </a>
        </div>
    </form>


    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Verified</th>
                        <th>Joined</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users.Items)
                    {
                        <tr class="@(!user.IsActive ? "table-secondary text-muted" : "")">
                            <td class="small">@user.UserId</td>
                            <td>
                                <span class="fw-semibold">@user.FullName</span>
                            </td>
                            <td class="small">@user.Email</td>
                            <td class="small">@user.Phone</td>
                            <td>
                                <span class="badge @(user.Role == "Worker" ? "bg-info text-dark" : "bg-secondary")">
                                    @user.Role
                                </span>
                            </td>
                            <td>
                                <span class="badge @(user.IsActive ? "bg-success" : "bg-danger")">
                                    @(user.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>
                                @if (user.Role == "Worker")
                                {
                                    <span class="badge @(user.IsVerified ? "bg-primary" : "bg-light text-dark border")">
                                        @(user.IsVerified ? "✔ Verified" : "Unverified")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td class="small">@user.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td>
                                <div class="d-flex gap-1 flex-wrap">

                                    @if (user.Role == "Worker")
                                    {
                                        <a asp-action="WorkerProfile" asp-route-id="@user.UserId"
                                           class="btn btn-outline-dark btn-sm">
                                            View
                                        </a>

                                        @if (!user.IsVerified)
                                        {
                                            <form asp-action="VerifyWorker" method="post">
                                                <input type="hidden" name="workerId" value="@user.UserId" />
                                                <button type="submit"
                                                        class="btn btn-outline-primary btn-sm"
                                                        onclick="return confirm('Verify this worker?')">
                                                    Verify
                                                </button>
                                            </form>
                                        }
                                    }

                                    <form asp-action="ToggleActive" method="post">
                                        <input type="hidden" name="userId" value="@user.UserId" />
                                        <input type="hidden" name="isActive" value="@(!user.IsActive ? 1 : 0)" />
                                        <button type="submit"
                                                class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                                onclick="return confirm('@(user.IsActive ? "Deactivate" : "Activate") this user?')">
                                            @(user.IsActive ? "Deactivate" : "Activate")
                                        </button>
                                    </form>

                                </div>
                            </td>
                        </tr>
                    }

                    @if (!Model.Users.Items.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">No users found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="px-3 pb-3 mt-3">
        <partial name="_Pagination" model="Model.Users" />
    </div>
</div>