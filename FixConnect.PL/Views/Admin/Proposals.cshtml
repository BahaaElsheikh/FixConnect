@model FixConnect.PL.ViewModels.ProposalsListViewModel
@{
    ViewData["Title"] = "All Proposals";
}


<partial name="_AdminNav" />

<div class="container-fluid py-4">
    <h5 class="fw-bold mb-4">All Proposals</h5>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Request</th>
                        <th>Worker</th>
                        <th>Customer</th>
                        <th>Labor</th>
                        <th>Material</th>
                        <th>Duration</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Proposals)
                    {
                        <tr>
                            <td class="small">@p.ProposalId</td>
                            <td class="fw-semibold small">@p.RequestTitle</td>
                            <td class="small">@p.WorkerName</td>
                            <td class="small">@p.CustomerName</td>
                            <td class="small">@(p.LaborCost?.ToString("0.00") ?? "—")</td>
                            <td class="small">@(p.MaterialCost?.ToString("0.00") ?? "—")</td>
                            <td class="small">@(p.DurationEstimate.HasValue ? $"{p.DurationEstimate} days" : "—")</td>
                            <td>
                                <span class="badge @(p.Status == "Pending"      ? "bg-warning text-dark" :
                                                                                           p.Status == "Accepted" ? "bg-success" :
                                                                                           p.Status == "Rejected" ? "bg-danger" :
                                                                                                                        "bg-secondary")">
                                @p.Status
                            </span>
                        </td>
                        <td>
                            <form asp-action="DeleteProposal" method="post"
                                  onsubmit="return confirm('Delete this proposal?')">
                                <input type="hidden" name="proposalId" value="@p.ProposalId" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                                        }

                    @if (!Model.Proposals.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">No proposals found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>