@model FixConnect.PL.ViewModels.RequestsListViewModel
@{
    ViewData["Title"] = "All Requests";
}
<partial name="_AdminNav" />
<div class="container-fluid py-4">
    <h5 class="fw-bold mb-4">All Requests</h5>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Title</th>
                        <th>Customer</th>
                        <th>Region</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                   @foreach (var r in Model.Requests.Items)  

                    {
                        <tr>
                            <td class="small">@r.RequestId</td>
                            <td class="fw-semibold">@r.Title</td>
                            <td class="small">@r.CustomerName</td>
                            <td class="small">@r.RegionName</td>
                            <td>
                                <span class="badge bg-light text-dark border">@r.RequestType</span>
                            </td>
                            <td>
                                <span class="badge @(r.Status == "Pending"    ? "bg-warning text-dark" :
                                                                                           r.Status == "InProgress" ? "bg-info text-dark" :
                                                                                           r.Status == "Completed" ? "bg-success" :
                                                                                                                      "bg-secondary")">
                                @r.Status
                            </span>
                        </td>
                        <td class="small">@r.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td>
                            <form asp-action="DeleteRequest" method="post"
                                  onsubmit="return confirm('Delete this request?')">
                                <input type="hidden" name="requestId" value="@r.RequestId" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                                        }

                    @if (!Model.Requests.Items.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">No requests found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="px-3 pb-3">
        <partial name="_Pagination" model="Model.Requests" />
    </div>

</div>