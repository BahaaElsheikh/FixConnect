@model FixConnect.PL.ViewModels.CustomerHomeViewModel
@{ ViewData["Title"] = "Find a Worker"; 
    Layout = "_CustomerLayout";
}


<div class="container py-4">

    <!-- Search & Filter -->
    <form method="get" asp-action="Index" class="d-flex gap-2 mb-4 flex-wrap">
        <input type="text" name="search" value="@Model.SearchQuery"
               class="form-control" style="max-width:220px" placeholder="Search worker..." />

        <select name="specialtyId" class="form-select" style="max-width:180px">
            <option value="">All Specialties</option>
            @foreach (var s in Model.Specialties)
            {
                <option value="@s.SpecialtyId"
                        selected="@(Model.SelectedSpecialtyId == s.SpecialtyId)">
                    @s.SpecialtyName
                </option>
            }
        </select>

        <select name="regionId" class="form-select" style="max-width:180px">
            <option value="">All Regions</option>
            @foreach (var r in Model.Regions)
            {
                <option value="@r.RegionId"
                        selected="@(Model.SelectedRegionId == r.RegionId)">
                    @r.RegionName
                </option>
            }
        </select>

        <button type="submit" class="btn btn-dark">Search</button>
    </form>

    <!-- Worker Grid -->
    @if (!Model.Workers.Any())
    {
        <div class="text-center text-muted py-5">No workers found.</div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var w in Model.Workers)
            {
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="card shadow-sm h-100 text-center p-3">
                        <img src="@(w.PhotoUrl ?? "/uploads/ProfilePictures/default.png")"
                             class="rounded-circle mx-auto mb-2"
                             style="width:80px;height:80px;object-fit:cover;" />

                        <h6 class="fw-bold mb-0">
                            @w.FullName
                            @if (w.IsVerified)
                            {
                                <span class="badge bg-primary" style="font-size:0.6rem">✔</span>
                            }
                        </h6>

                        <p class="text-muted small mb-1">@w.SpecialtyName</p>

                        <div class="mb-1">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <span style="color:@(i <= (int)w.AvgRating ? "#f5a623" : "#ccc");font-size:0.9rem">★</span>
                            }
                        </div>

                        <span class="badge @(w.AvailabilityStatus == "Available" ? "bg-success" :
                                             w.AvailabilityStatus == "Busy"      ? "bg-warning text-dark" :
                                                                                    "bg-secondary") mb-2">
                            @w.AvailabilityStatus
                        </span>

                        <div class="d-flex flex-wrap justify-content-center gap-1 mb-2">
                            @foreach (var region in w.Regions.Take(2))
                            {
                                <span class="badge bg-light text-dark border" style="font-size:0.65rem">@region</span>
                            }
                        </div>

                        <div class="d-flex gap-1 mt-auto">
                            <a asp-action="WorkerProfile" asp-route-id="@w.UserId"
                               class="btn btn-outline-dark btn-sm flex-fill">
                                View
                            </a>
                            <a asp-action="CreateRequest" asp-route-workerId="@w.UserId"
                               class="btn btn-dark btn-sm flex-fill">
                                Request
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>