@model FixConnect.PL.ViewModels.ReceivedProposalsViewModel
@{
    ViewData["Title"] = "Proposals";
    Layout = "_CustomerLayout";
}

<style>
    :root {
        --fc-blue: #1a4fd6;
        --fc-blue-light: #e8effe;
        --fc-blue-mid: #3b6fe8;
        --fc-bg: #f0f4fb;
        --fc-card: #ffffff;
        --fc-text: #1a1f36;
        --fc-muted: #6b7a99;
        --fc-border: #dde4f0;
        --fc-green: #16a34a;
        --fc-green-bg: #dcfce7;
        --fc-green-bdr: #86efac;
        --fc-warning: #d97706;
        --fc-warning-bg: #fef3c7;
        --fc-warning-bdr: #fde68a;
        --fc-danger: #dc2626;
        --fc-danger-bg: #fee2e2;
        --fc-danger-bdr: #fca5a5;
        --fc-star-on: #f5a623;
        --fc-star-off: #dde4f0;
        --fc-radius: 14px;
        --fc-radius-sm: 8px;
        --fc-shadow: 0 2px 16px rgba(26,79,214,.08);
        --fc-shadow-md: 0 4px 24px rgba(26,79,214,.13);
    }

    .fc-page {
        background: var(--fc-bg);
        min-height: 100vh;
        padding: 2.5rem 1rem 3.5rem;
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    /* ── Top bar ── */
    .fc-topbar {
        display: flex;
        align-items: center;
        gap: .85rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }

    .fc-back-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: .45rem .9rem;
        font-size: .8rem;
        font-weight: 600;
        color: var(--fc-muted);
        background: var(--fc-card);
        border: 1.5px solid var(--fc-border);
        border-radius: var(--fc-radius-sm);
        text-decoration: none;
        transition: all .15s;
        flex-shrink: 0;
    }

        .fc-back-btn:hover {
            border-color: var(--fc-blue);
            color: var(--fc-blue);
            background: var(--fc-blue-light);
        }

    .fc-page-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--fc-text);
        margin: 0;
    }

        .fc-page-title span {
            color: var(--fc-blue);
        }

    /* ── Empty ── */
    .fc-empty {
        text-align: center;
        padding: 4rem 1rem;
        color: var(--fc-muted);
    }

    .fc-empty-icon {
        font-size: 2.8rem;
        margin-bottom: .75rem;
    }

    .fc-empty p {
        font-size: .9rem;
    }

    /* ── Proposal Card ── */
    .fc-proposal-card {
        background: var(--fc-card);
        border: 1px solid var(--fc-border);
        border-radius: var(--fc-radius);
        box-shadow: var(--fc-shadow);
        margin-bottom: 1.1rem;
        overflow: hidden;
        transition: box-shadow .2s;
    }

        .fc-proposal-card:hover {
            box-shadow: var(--fc-shadow-md);
        }

    /* 3-column grid */
    .fc-proposal-body {
        display: grid;
        grid-template-columns: 190px 1fr 1fr;
        gap: 0;
    }

    .fc-col-worker {
        padding: 1.4rem 1.1rem;
        border-right: 1px solid var(--fc-border);
        text-align: center;
    }

    .fc-col-info {
        padding: 1.4rem 1.1rem;
        border-right: 1px solid var(--fc-border);
    }

    .fc-col-extra {
        padding: 1.4rem 1.1rem;
    }

    /* ── Worker ── */
    .fc-worker-photo {
        width: 68px;
        height: 68px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid var(--fc-blue-light);
        box-shadow: 0 0 0 3px #fff, 0 3px 10px rgba(26,79,214,.15);
        display: block;
        margin: 0 auto .65rem;
    }

    .fc-worker-name {
        font-size: .875rem;
        font-weight: 700;
        color: var(--fc-text);
        margin-bottom: .2rem;
    }

    .fc-badge-verified {
        display: inline-block;
        background: var(--fc-blue);
        color: #fff;
        font-size: .6rem;
        font-weight: 700;
        padding: 1px 6px;
        border-radius: 20px;
        margin-left: 3px;
        vertical-align: middle;
    }

    .fc-worker-specialty {
        font-size: .75rem;
        color: var(--fc-muted);
        margin-bottom: .45rem;
    }

    .fc-worker-stars {
        font-size: .85rem;
        margin-bottom: .65rem;
    }

        .fc-worker-stars .s-on {
            color: var(--fc-star-on);
        }

        .fc-worker-stars .s-off {
            color: var(--fc-star-off);
        }

    .fc-btn-profile {
        display: block;
        width: 100%;
        padding: 5px 0;
        font-size: .75rem;
        font-weight: 600;
        color: var(--fc-blue);
        background: var(--fc-blue-light);
        border: 1px solid #c5d6f8;
        border-radius: var(--fc-radius-sm);
        text-decoration: none;
        text-align: center;
        transition: background .15s;
    }

        .fc-btn-profile:hover {
            background: #d4e3fc;
            color: var(--fc-blue);
        }

    /* ── Info ── */
    .fc-col-label {
        font-size: .7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
        color: var(--fc-muted);
        margin-bottom: .65rem;
    }

    .fc-info-stats {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 7px;
        margin-bottom: .75rem;
    }

    .fc-stat {
        background: var(--fc-bg);
        border-radius: var(--fc-radius-sm);
        padding: .5rem .65rem;
    }

    .fc-stat-label {
        font-size: .65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .3px;
        color: var(--fc-muted);
        margin-bottom: .2rem;
    }

    .fc-stat-val {
        font-size: .85rem;
        font-weight: 700;
        color: var(--fc-text);
    }

    .fc-notes-box {
        background: var(--fc-bg);
        border-radius: var(--fc-radius-sm);
        padding: .5rem .7rem;
        font-size: .78rem;
        color: var(--fc-muted);
        font-style: italic;
        line-height: 1.55;
        margin-bottom: .6rem;
    }

    /* Status */
    .fc-status {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .2px;
    }

        .fc-status.pending {
            background: var(--fc-warning-bg);
            color: var(--fc-warning);
            border: 1px solid var(--fc-warning-bdr);
        }

        .fc-status.accepted {
            background: var(--fc-green-bg);
            color: var(--fc-green);
            border: 1px solid var(--fc-green-bdr);
        }

        .fc-status.rejected {
            background: var(--fc-danger-bg);
            color: var(--fc-danger);
            border: 1px solid var(--fc-danger-bdr);
        }

        .fc-status.other {
            background: #f1f5f9;
            color: var(--fc-muted);
            border: 1px solid var(--fc-border);
        }

    /* ── Extras ── */
    .fc-portfolio-thumbs {
        display: flex;
        gap: 5px;
        flex-wrap: wrap;
        margin-bottom: .75rem;
    }

    .fc-portfolio-thumb {
        width: 56px;
        height: 56px;
        object-fit: cover;
        border-radius: 7px;
        border: 1px solid var(--fc-border);
        cursor: pointer;
        transition: transform .15s, box-shadow .15s;
    }

        .fc-portfolio-thumb:hover {
            transform: scale(1.07);
            box-shadow: var(--fc-shadow);
        }

    .fc-review-box {
        background: var(--fc-bg);
        border-radius: var(--fc-radius-sm);
        padding: .6rem .75rem;
        font-size: .78rem;
        color: var(--fc-muted);
        line-height: 1.55;
        font-style: italic;
    }

    .fc-review-by {
        font-size: .72rem;
        font-style: normal;
        margin-top: .2rem;
    }

    /* ── Footer ── */
    .fc-proposal-footer {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 7px;
        padding: .75rem 1.1rem;
        border-top: 1px solid var(--fc-border);
        background: var(--fc-bg);
    }

    .fc-btn-accept {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: .5rem 1.2rem;
        font-size: .82rem;
        font-weight: 700;
        color: #fff;
        background: var(--fc-green);
        border: none;
        border-radius: var(--fc-radius-sm);
        text-decoration: none;
        transition: background .15s, transform .12s;
        box-shadow: 0 3px 10px rgba(22,163,74,.22);
    }

        .fc-btn-accept:hover {
            background: #15803d;
            color: #fff;
            transform: translateY(-1px);
        }

    /* ── Image Modal ── */
    .fc-img-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(10,15,30,.7);
        backdrop-filter: blur(6px);
        z-index: 1050;
        align-items: center;
        justify-content: center;
    }

        .fc-img-backdrop.open {
            display: flex;
        }

    .fc-img-box {
        max-width: 700px;
        width: 92%;
        border-radius: var(--fc-radius);
        overflow: hidden;
        animation: fcIn .2s ease;
        position: relative;
    }

    @@keyframes fcIn {
        from {
            transform: scale(.93);
            opacity: 0
        }

        to {
            transform: scale(1);
            opacity: 1
        }
    }

    .fc-img-box img {
        width: 100%;
        max-height: 520px;
        object-fit: contain;
        background: #000;
        display: block;
    }

    .fc-img-close {
        position: absolute;
        top: 10px;
        right: 10px;
        background: rgba(0,0,0,.5);
        color: #fff;
        border: none;
        border-radius: 50%;
        width: 32px;
        height: 32px;
        font-size: 1rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .fc-img-close:hover {
            background: rgba(0,0,0,.85);
        }

    @@media (max-width: 860px) {
        .fc-proposal-body {
            grid-template-columns: 1fr 1fr;
        }

        .fc-col-worker {
            border-right: none;
            border-bottom: 1px solid var(--fc-border);
            grid-column: 1/-1;
            display: flex;
            align-items: center;
            gap: 1rem;
            text-align: left;
        }

        .fc-worker-photo {
            margin: 0;
            width: 52px;
            height: 52px;
        }

        .fc-btn-profile {
            width: auto;
            padding: 4px 14px;
        }
    }

    @@media (max-width: 600px) {
        .fc-proposal-body {
            grid-template-columns: 1fr;
        }

        .fc-col-info {
            border-right: none;
            border-bottom: 1px solid var(--fc-border);
        }

        .fc-col-worker {
            border-bottom: 1px solid var(--fc-border);
        }
    }
</style>

<div class="fc-page">
    <div class="container">

        <!-- Top bar -->
        <div class="fc-topbar">
            <a asp-action="MyRequests" class="fc-back-btn">← Back</a>
            <h5 class="fc-page-title">
                Proposals for: <span>@ViewBag.RequestTitle</span>
            </h5>
        </div>

        @if (!Model.Proposals.Any())
        {
            <div class="fc-empty">
                <div class="fc-empty-icon">📨</div>
                <p>No proposals yet. Workers will start bidding soon!</p>
            </div>
        }
        else
        {
            @foreach (var p in Model.Proposals)
            {
                var statusClass = p.Status switch
                {
                    "Pending" => "pending",
                    "Accepted" => "accepted",
                    "Rejected" => "rejected",
                    _ => "other"
                };

                <div class="fc-proposal-card">
                    <div class="fc-proposal-body">

                        <!-- Worker -->
                        <div class="fc-col-worker">
                            <img src="@(p.WorkerPhoto ?? "/uploads/ProfilePictures/default.png")"
                                 class="fc-worker-photo" alt="@p.WorkerName" />
                            <div>
                                <div class="fc-worker-name">
                                    @p.WorkerName
                                    @if (p.WorkerIsVerified)
                                    {
                                        <span class="fc-badge-verified">✔</span>
                                    }
                                </div>
                                <div class="fc-worker-specialty">@p.WorkerSpecialty</div>
                                <div class="fc-worker-stars">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <span class="@(i <= (int)p.WorkerRating ? "s-on" : "s-off")">★</span>
                                    }
                                </div>
                                <a asp-action="WorkerProfile"
                                   asp-route-id="@p.WorkerId"
                                   class="fc-btn-profile">View Profile</a>
                            </div>
                        </div>

                        <!-- Info -->
                        <div class="fc-col-info">
                            <div class="fc-col-label">Proposal Details</div>
                            <div class="fc-info-stats">
                                <div class="fc-stat">
                                    <div class="fc-stat-label">💰 Labor</div>
                                    <div class="fc-stat-val">@(p.LaborCost?.ToString("0.00") ?? "—") <small style="font-size:.6rem;font-weight:400">EGP</small></div>
                                </div>
                                <div class="fc-stat">
                                    <div class="fc-stat-label">🔩 Material</div>
                                    <div class="fc-stat-val">@(p.MaterialCost?.ToString("0.00") ?? "—") <small style="font-size:.6rem;font-weight:400">EGP</small></div>
                                </div>
                                <div class="fc-stat">
                                    <div class="fc-stat-label">📅 Duration</div>
                                    <div class="fc-stat-val">@(p.DurationEstimate.HasValue ? $"{p.DurationEstimate} days" : "—")</div>
                                </div>
                                <div class="fc-stat">
                                    <div class="fc-stat-label">🕐 Est. Start</div>
                                    <div class="fc-stat-val" style="font-size:.72rem;">@(p.EstimatedStartTime.HasValue? p.EstimatedStartTime.Value.ToString("dd MMM, hh:mm tt") : "—")</div>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(p.Notes))
                            {
                                <div class="fc-notes-box">📝 "@p.Notes"</div>
                            }

                            <span class="fc-status @statusClass">@p.Status</span>
                        </div>

                        <!-- Extras -->
                        <div class="fc-col-extra">
                            @if (p.Portfolio.Any())
                            {
                                <div class="fc-col-label">Portfolio</div>
                                <div class="fc-portfolio-thumbs">
                                    @foreach (var item in p.Portfolio.Take(4))
                                    {
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl" class="fc-portfolio-thumb"
                                                 onclick="fcOpenImg('@item.ImageUrl')" alt="Portfolio" />
                                        }
                                    }
                                </div>
                            }

                            @if (p.Reviews.Any())
                            {
                                var rev = p.Reviews.First();
                                <div class="fc-col-label" style="margin-top:.5rem;">Latest Review</div>
                                <div class="fc-review-box">
                                    "@rev.Comment"
                                    <div class="fc-review-by">— @rev.CustomerName</div>
                                </div>
                            }
                        </div>

                    </div>

                    <!-- Footer -->
                    <div class="fc-proposal-footer">
                        @if (p.Status == "Pending")
                        {
                            <a asp-action="AcceptProposal"
                               asp-route-proposalId="@p.ProposalId"
                               class="fc-btn-accept">
                                ✔ Accept Proposal
                            </a>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- Image Modal -->
<div class="fc-img-backdrop" id="fcImgModal" onclick="if(event.target===this)fcCloseImg()">
    <div class="fc-img-box">
        <button class="fc-img-close" onclick="fcCloseImg()">✕</button>
        <img id="fcImgSrc" src="" alt="Preview" />
    </div>
</div>

<script>
    function fcOpenImg(src) {
        document.getElementById('fcImgSrc').src = src;
        document.getElementById('fcImgModal').classList.add('open');
        document.body.style.overflow = 'hidden';
    }
    function fcCloseImg() {
        document.getElementById('fcImgModal').classList.remove('open');
        document.body.style.overflow = '';
    }
    document.addEventListener('keydown', e => { if (e.key === 'Escape') fcCloseImg(); });
</script>
