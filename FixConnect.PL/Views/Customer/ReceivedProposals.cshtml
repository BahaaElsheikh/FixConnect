@model FixConnect.PL.ViewModels.ReceivedProposalsViewModel
@{ ViewData["Title"] = "Received Proposals";
    Layout = "_CustomerLayout";
 }
@* <partial name="_CustomerNav" /> *@

<div class="container py-4">
    <h5 class="fw-bold mb-4">Received Proposals</h5>

    @if (!Model.Proposals.Any())
    {
        <div class="text-center text-muted py-5">No proposals received yet.</div>
    }
    else
    {
        @foreach (var p in Model.Proposals)
        {
            <div class="card shadow-sm mb-4 p-4">
                <div class="row g-3">

                    <!-- Worker Info -->
                    <div class="col-md-3 text-center">
                        <img src="@(p.WorkerPhoto ?? "/uploads/ProfilePictures/default.png")"
                             class="rounded-circle mb-2"
                             style="width:80px;height:80px;object-fit:cover;" />
                        <h6 class="fw-bold mb-0">
                            @p.WorkerName
                            @if (p.WorkerIsVerified)
                            {
                                <span class="badge bg-primary" style="font-size:0.6rem">✔</span>
                            }
                        </h6>
                        <p class="text-muted small mb-1">@p.WorkerSpecialty</p>
                        <div>
                            @for (int i = 1; i <= 5; i++)
                            {
                                <span style="color:@(i <= (int)p.WorkerRating ? "#f5a623" : "#ccc")">★</span>
                            }
                        </div>
                    </div>

                    <!-- Proposal Info -->
                    <div class="col-md-4">
                        <p class="small text-muted mb-1">Request: <strong>@p.RequestTitle</strong></p>
                        <p class="small mb-1">💰 Labor: <strong>@(p.LaborCost?.ToString("0.00") ?? "—") EGP</strong></p>
                        <p class="small mb-1">🔩 Material: <strong>@(p.MaterialCost?.ToString("0.00") ?? "—") EGP</strong></p>
                        <p class="small mb-1">📅 Duration: <strong>@(p.DurationEstimate.HasValue ? $"{p.DurationEstimate} days" : "—")</strong></p>
                        <span class="badge @(p.Status == "Pending"  ? "bg-warning text-dark" :
                                             p.Status == "Accepted" ? "bg-success"           :
                                             p.Status == "Rejected" ? "bg-danger"            :
                                                                       "bg-secondary")">
                            @p.Status
                        </span>
                    </div>

                    <!-- Portfolio -->
                    <div class="col-md-5">
                        @if (p.Portfolio.Any())
                        {
                            <p class="small fw-semibold mb-1">Portfolio</p>
                            <div class="d-flex gap-1 flex-wrap mb-2">
                                @foreach (var item in p.Portfolio.Take(3))
                                {
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl"
                                             style="width:55px;height:55px;object-fit:cover;border-radius:4px;" />
                                    }
                                }
                            </div>
                        }

                        @if (p.Reviews.Any())
                        {
                            <p class="small fw-semibold mb-1">Latest Review</p>
                            var rev = p.Reviews.First();
                            <p class="small text-muted mb-0">
                                "@rev.Comment" — @rev.CustomerName
                            </p>
                        }
                    </div>

                </div>
            </div>
        }
    }
</div>