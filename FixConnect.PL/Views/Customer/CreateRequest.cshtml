@model FixConnect.PL.ViewModels.CreateRequestViewModel
@{
    ViewData["Title"] = "Create Request";
    Layout = "_CustomerLayout";
}


<div class="container py-4" style="max-width:620px">
    <h5 class="fw-bold mb-4">New Request</h5>

    @if (!string.IsNullOrEmpty(Model.TargetWorkerName))
    {
        <div class="alert alert-info">
            Sending to: <strong>@Model.TargetWorkerName</strong>
        </div>
    }

    <form asp-action="CreateRequest" method="post" enctype="multipart/form-data">
        <input type="hidden" name="TargetWorkerId" value="@Model.TargetWorkerId" />

        <div class="card shadow-sm p-4">

            <div class="mb-3">
                <label class="form-label">Title</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Region</label>
                <select asp-for="RegionId" class="form-select">
                    <option value="">— Select Region —</option>
                    @foreach (var r in Model.Regions)
                    {
                        <option value="@r.RegionId">@r.RegionName</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Specialty (Optional)</label>
                <select asp-for="SpecialtyId" class="form-select">
                    <option value="">— Any Specialty —</option>
                    @foreach (var s in Model.Specialties)
                    {
                        <option value="@s.SpecialtyId">@s.SpecialtyName</option>
                    }
                </select>
            </div>

            @if (Model.TargetWorkerId.HasValue)
            {
                <div class="mb-3">
                    <label class="form-label">Visibility</label>
                    <div class="d-flex gap-3">
                        <div class="form-check">
                            <input class="form-check-input" type="radio"
                                   name="IsPrivate" value="true"
                                   @(Model.IsPrivate ? "checked" : "") />
                            <label class="form-check-label">Private to this Worker</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio"
                                   name="IsPrivate" value="false"
                                   @(!Model.IsPrivate ? "checked" : "") />
                            <label class="form-check-label">Make it Public</label>
                        </div>
                    </div>
                </div>
            }

            <div class="mb-3">
                <label class="form-label">Images (Optional)</label>
                <input name="Images" type="file" class="form-control"
                       accept="image/*" multiple />
            </div>

            <button type="submit" class="btn btn-dark w-100">Submit Request</button>
        </div>
    </form>
</div>