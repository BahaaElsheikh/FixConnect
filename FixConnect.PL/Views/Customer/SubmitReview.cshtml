@model FixConnect.PL.ViewModels.SubmitReviewViewModel
@{
    ViewData["Title"] = "Submit Review";
    Layout = "_CustomerLayout";
}

<div class="container py-4" style="max-width:580px">

    <!-- Worker Info -->
    <div class="text-center mb-4">
        <img src="@(Model.WorkerPhoto ?? "/uploads/ProfilePictures/default.png")"
             class="rounded-circle mb-2"
             style="width:80px;height:80px;object-fit:cover;" />
        <h5 class="fw-bold mb-0">@Model.WorkerName</h5>
        <p class="text-muted small">@Model.RequestTitle</p>
    </div>

    <form asp-action="SubmitReview" method="post">
        <input type="hidden" asp-for="JobId" />
        <input type="hidden" asp-for="WorkerId" />
        <input type="hidden" asp-for="WorkerName" />
        <input type="hidden" asp-for="WorkerPhoto" />
        <input type="hidden" asp-for="RequestTitle" />

        <div class="card shadow-sm p-4">

            <!-- Accuracy Rating -->
            <div class="mb-4">
                <label class="form-label fw-semibold">
                    🎯 Accuracy & Quality
                </label>
                <div class="star-group" data-field="AccuracyRating">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <span class="star" data-val="@i">★</span>
                    }
                </div>
                <input type="hidden" asp-for="AccuracyRating" class="star-input" />
                <span asp-validation-for="AccuracyRating" class="text-danger small"></span>
            </div>

            <!-- Commitment Rating -->
            <div class="mb-4">
                <label class="form-label fw-semibold">
                    📅 Commitment
                </label>
                <div class="star-group" data-field="CommitmentRating">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <span class="star" data-val="@i">★</span>
                    }
                </div>
                <input type="hidden" asp-for="CommitmentRating" class="star-input" />
                <span asp-validation-for="CommitmentRating" class="text-danger small"></span>
            </div>

            <!-- Price Rating -->
            <div class="mb-4">
                <label class="form-label fw-semibold">
                    💰 Price Fairness
                </label>
                <div class="star-group" data-field="PriceRating">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <span class="star" data-val="@i">★</span>
                    }
                </div>
                <input type="hidden" asp-for="PriceRating" class="star-input" />
                <span asp-validation-for="PriceRating" class="text-danger small"></span>
            </div>

            <!-- Suggest Worker -->
            <div class="mb-4">
                <div class="form-check form-switch">
                    <input asp-for="SuggestWorker" class="form-check-input"
                           type="checkbox" role="switch" />
                    <label class="form-check-label fw-semibold">
                        👍 Would you suggest this worker to others?
                    </label>
                </div>
            </div>

            <!-- Comment -->
            <div class="mb-4">
                <label class="form-label fw-semibold">Comment (Optional)</label>
                <textarea asp-for="Comment" class="form-control" rows="3"
                          placeholder="Share your experience..."></textarea>
            </div>

            <button type="submit" class="btn btn-dark w-100 fw-bold">
                Submit Review
            </button>
        </div>
    </form>
</div>

<style>
    .star-group {
        display: flex;
        gap: 6px;
        margin-top: 6px;
    }

    .star {
        font-size: 2rem;
        color: #ddd;
        cursor: pointer;
        transition: color 0.15s, transform 0.1s;
        user-select: none;
    }

        .star:hover, .star.active {
            color: #f5a623;
        }

        .star:hover {
            transform: scale(1.15);
        }
</style>

<script>
    document.querySelectorAll('.star-group').forEach(group => {
        const stars  = group.querySelectorAll('.star');
        const field  = group.dataset.field;
        const input  = document.querySelector(`input[name="${field}"]`);

        stars.forEach((star, idx) => {
            star.addEventListener('click', () => {
                const val = parseInt(star.dataset.val);
                input.value = val;
                stars.forEach((s, i) => {
                    s.classList.toggle('active', i < val);
                });
            });

            star.addEventListener('mouseover', () => {
                const val = parseInt(star.dataset.val);
                stars.forEach((s, i) => {
                    s.style.color = i < val ? '#f5a623' : '#ddd';
                });
            });

            star.addEventListener('mouseout', () => {
                const current = parseInt(input.value) || 0;
                stars.forEach((s, i) => {
                    s.style.color = i < current ? '#f5a623' : '#ddd';
                });
            });
        });
    });
</script>