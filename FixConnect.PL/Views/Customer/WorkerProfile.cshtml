@* @model FixConnect.BLL.DTOs.PublicWorkerProfileViewModel *@
@model FixConnect.PL.ViewModels.WorkerProfileViewModel
@{
    ViewData["Title"] = Model.FullName;
    Layout = "_CustomerLayout";
}

<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

<script id="tailwind-config">
    tailwind.config = {
        darkMode: "class",
        theme: {
            extend: {
                "colors": {
                    "surface-container-low": "#f2f4f6",
                    "surface-variant": "#e0e3e5",
                    "surface": "#f7f9fb",
                    "outline": "#737688",
                    "primary-container": "#0052ff",
                    "on-primary-container": "#dfe3ff",
                    "on-surface": "#191c1e",
                    "surface-container-lowest": "#ffffff",
                    "background": "#f7f9fb",
                    "primary": "#003ec7",
                    "secondary": "#5d5e62",
                    "outline-variant": "#c3c5d9",
                    "surface-container-high": "#e6e8ea"
                },
                "spacing": {
                    "gutter": "24px",
                    "stack-md": "24px",
                    "container-margin": "32px",
                    "stack-lg": "48px"
                },
                "fontFamily": {
                    "label-md": ["Plus Jakarta Sans"],
                    "headline-lg": ["Plus Jakarta Sans"],
                    "body-md": ["Plus Jakarta Sans"],
                    "headline-md": ["Plus Jakarta Sans"],
                    "display-xl": ["Plus Jakarta Sans"],
                    "caption": ["Plus Jakarta Sans"],
                    "body-lg": ["Plus Jakarta Sans"]
                }
            }
        }
    }
</script>

<style>
    .glass-panel {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
    }

    .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }

    .btn-primary {
        background: linear-gradient(135deg, #003ec7 0%, #0052ff 100%);
    }

        .btn-primary:hover {
            box-shadow: 0 10px 15px -3px rgba(0, 82, 255, 0.2);
            transform: translateY(-1px);
        }

    ::-webkit-scrollbar {
        width: 6px;
    }

    ::-webkit-scrollbar-track {
        background: transparent;
    }

    ::-webkit-scrollbar-thumb {
        background: #e0e3e5;
        border-radius: 4px;
    }
</style>

<div class="max-w-[1440px] mx-auto p-4 md:p-8 lg:p-container-margin relative z-10">

    <!-- ═══════════════════════════════
         HERO — Profile Header
    ═══════════════════════════════ -->
    <div class="relative bg-surface-container-lowest rounded-2xl border border-surface-variant/50 p-6 md:p-10 mb-8 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.02)]">
        <div class="flex flex-col md:flex-row items-start md:items-center gap-6">

            <!-- Photo -->
            <div class="relative shrink-0">
                <div class="w-24 h-24 md:w-32 md:h-32 rounded-2xl overflow-hidden border-2 border-surface shadow-md">
                    <img src="@(Model.PhotoUrl ?? "/uploads/ProfilePictures/default.png")"
                         class="w-full h-full object-cover" alt="@Model.FullName" />
                </div>
                @if (Model.AvailabilityStatus == "Available")
                {
                    <div class="absolute -bottom-2 -right-2 bg-green-500/10 backdrop-blur-sm border border-green-200 text-green-700 px-2 py-0.5 rounded-full flex items-center gap-1 shadow-sm">
                        <div class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></div>
                        <span class="font-caption text-[10px] font-bold uppercase tracking-wider">Available</span>
                    </div>
                }
            </div>

            <!-- Info -->
            <div class="flex-1 space-y-2">
                <div class="flex items-center gap-3">
                    <h1 class="font-display-xl text-headline-lg md:text-display-xl text-on-surface">
                        @Model.FullName
                    </h1>
                    @if (Model.IsVerified)
                    {
                        <span class="material-symbols-outlined text-primary"
                              style="font-variation-settings: 'FILL' 1;" title="Verified Pro">verified</span>
                    }
                </div>

                <p class="font-body-lg text-body-lg text-secondary">
                    @Model.SpecialtyName
                    <span class="text-surface-variant mx-2">|</span>
                    📞 Phone : @Model.Phone
                </p>

                <div class="flex flex-wrap items-center gap-4 pt-2">
                    <div class="flex items-center gap-1 text-on-surface">
                        <span class="material-symbols-outlined text-amber-500 text-lg"
                              style="font-variation-settings: 'FILL' 1;">star</span>
                        <span class="font-label-md text-label-md">@Model.AvgRating.ToString("0.0") / 5</span>
                        <span class="font-caption text-caption text-secondary ml-1">
                            (@Model.Reviews.Count Reviews)
                        </span>
                    </div>
                    <div class="flex items-center gap-1 text-secondary">
                        <span class="material-symbols-outlined text-lg">task_alt</span>
                        <span class="font-caption text-caption">@Model.CompletedJobsCount Completed Jobs</span>
                    </div>
                </div>
            </div>

            <!-- Send Request Button -->
            <div class="flex flex-row md:flex-col gap-3 w-full md:w-auto mt-4 md:mt-0 shrink-0">
                <a asp-controller="Customer" asp-action="CreateRequest"
                   asp-route-workerId="@Model.UserId"
                   class="flex-1 md:flex-none btn-primary text-white font-label-md text-label-md py-2.5 px-6 rounded-lg transition-all shadow-md flex items-center justify-center gap-2 no-underline">
                    <span class="material-symbols-outlined text-sm">send</span>
                    Send Request
                </a>

                <a asp-controller="Reports" asp-action="Create"
                   asp-route-category="Worker"
                   asp-route-targetId="@Model.UserId"
                   class="flex-none btn-outline-danger border border-red-200 hover:bg-red-50 text-red-600 font-label-md text-label-md py-2.5 px-4 rounded-lg transition-all flex items-center justify-center gap-2 no-underline shadow-sm"
                   title="Report this worker">
                    <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">report</span>
                    Report
                </a>
            </div>

        </div>
    </div>

    <!-- ═══════════════════════════════
         MAIN GRID
    ═══════════════════════════════ -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">

        <!-- Left Column -->
        <div class="md:col-span-8 space-y-gutter">

            <section class="glass-panel rounded-2xl border border-surface-variant p-6 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.02)]">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="font-headline-md text-headline-md text-on-surface"> Reviews Summary </h2>
                </div>

                <div class="mb-6 grid grid-cols-1 sm:grid-cols-3 gap-3 bg-surface-container-low p-3 rounded-xl border border-surface-variant/60 shadow-sm">
                    <div class="bg-surface-container-lowest p-2 rounded-lg border border-surface-variant/30">
                        <div class="flex justify-between mb-1 items-center">
                            <span class="font-medium text-xs text-on-surface flex items-center gap-1">
                                <span class="material-symbols-outlined text-primary text-[16px]">track_changes</span>
                                Accuracy & Quality
                            </span>
                            <span class="font-bold text-xs text-primary">@Model.AvgAccuracyRating.ToString("0.0")</span>
                        </div>
                        <div class="w-full bg-surface-variant rounded-full h-1.5">
                            <div class="bg-primary h-1.5 rounded-full" style="width: @(Model.AvgAccuracyRating * 20)%"></div>
                        </div>
                    </div>

                    <div class="bg-surface-container-lowest p-2 rounded-lg border border-surface-variant/30">
                        <div class="flex justify-between mb-1 items-center">
                            <span class="font-medium text-xs text-on-surface flex items-center gap-1">
                                <span class="material-symbols-outlined text-teal-600 text-[16px]">calendar_clock</span>
                                Commitment
                            </span>
                            <span class="font-bold text-xs text-teal-600">@Model.AvgCommitmentRating.ToString("0.0")</span>
                        </div>
                        <div class="w-full bg-surface-variant rounded-full h-1.5">
                            <div class="bg-teal-500 h-1.5 rounded-full" style="width: @(Model.AvgCommitmentRating * 20)%"></div>
                        </div>
                    </div>

                    <div class="bg-surface-container-lowest p-2 rounded-lg border border-surface-variant/30">
                        <div class="flex justify-between mb-1 items-center">
                            <span class="font-medium text-xs text-on-surface flex items-center gap-1">
                                <span class="material-symbols-outlined text-amber-600 text-[16px]">payments</span>
                                Fair Pricing
                            </span>
                            <span class="font-bold text-xs text-amber-600">@Model.AvgPriceRating.ToString("0.0")</span>
                        </div>
                        <div class="w-full bg-surface-variant rounded-full h-1.5">
                            <div class="bg-amber-500 h-1.5 rounded-full" style="width: @(Model.AvgPriceRating * 20)%"></div>
                        </div>
                    </div>
                </div>

            </section>




            <!-- Bio -->
            @if (!string.IsNullOrEmpty(Model.Bio))
            {
                <section class="glass-panel rounded-2xl border border-surface-variant p-6 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.02)]">
                    <h2 class="font-headline-md text-headline-md text-on-surface mb-4">About</h2>
                    <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
                        @Model.Bio
                    </p>
                </section>
            }

            <!-- Portfolio -->
            <section class="glass-panel rounded-2xl border border-surface-variant p-6 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.02)]">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="font-headline-md text-headline-md text-on-surface">
                        Portfolio (@Model.PortfolioItems.Count)
                    </h2>
                </div>

                @if (!Model.PortfolioItems.Any())
                {
                    <div class="text-center py-8 text-secondary font-body-md text-sm border-2 border-dashed border-outline-variant rounded-xl">
                        No portfolio items yet.
                    </div>
                }
                else
                {
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                        @foreach (var item in Model.PortfolioItems)
                        {
                            <div class="border border-surface-variant rounded-xl overflow-hidden bg-surface-container-lowest shadow-sm flex flex-col cursor-pointer"
                                 onclick="openPortfolioModal('@item.ImageUrl', '@Html.Raw(item.Title)', '@Html.Raw(item.Description ?? "")')">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" class="w-full h-32 object-cover" alt="@item.Title" />
                                }
                                else
                                {
                                    <div class="w-full h-32 bg-surface-container flex items-center justify-center text-secondary">
                                        <span class="material-symbols-outlined text-4xl">image</span>
                                    </div>
                                }
                                <div class="p-4 flex-1 flex flex-col">
                                    <p class="font-label-md text-label-md text-on-surface mb-1">@item.Title</p>
                                    <p class="font-caption text-caption text-secondary line-clamp-2">@item.Description</p>
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>

            <!-- Reviews -->
            <section class="glass-panel rounded-2xl border border-surface-variant p-6 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.02)]">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="font-headline-md text-headline-md text-on-surface">Client Reviews</h2>
                    <span class="font-label-md text-label-md text-secondary">@Model.Reviews.Count Reviews</span>
                </div>

                @if (!Model.Reviews.Any())
                {
                    <p class="text-center py-6 text-secondary font-body-md text-sm">No reviews yet.</p>
                }
                else
                {
                    <div class="space-y-6">
                        @foreach (var r in Model.Reviews)
                        {
                            <div class="border-b border-surface-variant/50 pb-6 last:border-0 last:pb-0">
                                <div class="flex justify-between items-start mb-3">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-full bg-primary/10 text-primary font-headline-md text-lg flex items-center justify-center font-bold">
                                            @(!string.IsNullOrEmpty(r.CustomerName) ? r.CustomerName.Substring(0, 1).ToUpper() : "U")
                                        </div>
                                        <div>
                                            <p class="font-label-md text-label-md text-on-surface">@r.CustomerName</p>
                                            <div class="flex items-center gap-1 text-amber-500 mt-0.5">
                                                <span class="font-bold text-sm">@r.AvgRating.ToString("0.0")</span>
                                                <span class="material-symbols-outlined text-[16px]"
                                                      style="font-variation-settings: 'FILL' 1;">star</span>
                                            </div>
                                        </div>
                                    </div>
                                    @if (r.SuggestWorker)
                                    {
                                        <span class="bg-green-100 text-green-700 border border-green-200 px-2 py-1 rounded-md flex items-center gap-1 font-caption text-xs">
                                            <span class="material-symbols-outlined text-[14px]">thumb_up</span>
                                            Recommends
                                        </span>
                                    }
                                </div>

                                @if (!string.IsNullOrEmpty(r.Comment))
                                {
                                    <p class="font-body-md text-sm text-on-surface-variant italic mb-3">"@r.Comment"</p>
                                }

                                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-3 bg-surface-container-low p-3 rounded-lg border border-surface-variant/50">
                                    @{
                                        void TailwindRatingBar(string label, int val, string icon)
                                        {
                                            <div>
                                                <div class="flex justify-between mb-1">
                                                    <span class="font-caption text-[11px] text-secondary flex items-center gap-1">
                                                        <span class="material-symbols-outlined text-[14px]">@icon</span>
                                                        @label
                                                    </span>
                                                    <span class="font-caption text-[11px] font-bold text-on-surface">@val/5</span>
                                                </div>
                                                <div class="w-full bg-surface-variant rounded-full h-1.5">
                                                    <div class="bg-amber-500 h-1.5 rounded-full" style="width: @(val * 20)%"></div>
                                                </div>
                                            </div>
                                        }
                                    }
                                    @{
                                        TailwindRatingBar("Accuracy", r.AccuracyRating, "track_changes");
                                    }
                                    @{
                                        TailwindRatingBar("Commitment", r.CommitmentRating, "calendar_clock");
                                    }
                                    @{
                                        TailwindRatingBar("Price", r.PriceRating, "payments");
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>

        </div>

        <!-- Right Column -->
        <div class="md:col-span-4 space-y-gutter">

            <!-- Availability (Read Only) -->
            <section class="glass-panel rounded-2xl border border-surface-variant p-6 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.02)]">
                <div class="flex items-center gap-2 mb-4">
                    <span class="material-symbols-outlined text-primary">toggle_on</span>
                    <h2 class="font-headline-md text-lg text-on-surface font-bold">Availability</h2>
                </div>
                @{
                    var (availColor, availLabel) = Model.AvailabilityStatus switch
                    {
                        "Available" => ("bg-green-600 text-white border-green-700", "Available"),
                        "Busy" => ("bg-amber-500 text-white border-amber-600", "Busy"),
                        _ => ("bg-secondary text-white border-secondary", "Offline")
                    };
                }
                <div class="w-full py-2.5 rounded-lg border font-label-md text-sm @availColor flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-[16px]">check_circle</span>
                    @availLabel
                </div>
            </section>

            <!-- Service Areas (Read Only) -->
            <section class="glass-panel rounded-2xl border border-surface-variant p-6 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.02)]">
                <div class="flex items-center gap-2 mb-4">
                    <span class="material-symbols-outlined text-on-surface">map</span>
                    <h2 class="font-headline-md text-lg font-bold text-on-surface">Service Areas</h2>
                </div>

                <div class="flex flex-wrap gap-2 mb-4">
                    @if (!Model.WorkingRegions.Any())
                    {
                        <span class="text-caption text-secondary italic">No areas listed.</span>
                    }
                    @foreach (var region in Model.WorkingRegions)
                    {
                        <span class="bg-primary/10 text-primary font-caption text-xs px-2.5 py-1.5 rounded-lg border border-primary/20">
                            @region
                        </span>
                    }
                </div>

                <div class="h-32 mt-4 rounded-lg overflow-hidden bg-surface-container relative border border-outline-variant/50">
                    <div class="absolute inset-0 flex items-center justify-center bg-surface-variant/20">
                        <img src="~/uploads/Default/egypt.jpeg"
                             class="w-full h-full object-cover opacity-50 mix-blend-multiply"
                             alt="Map" />
                        <div class="absolute w-12 h-12 bg-primary/20 rounded-full flex items-center justify-center animate-pulse">
                            <div class="w-3 h-3 bg-primary rounded-full"></div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Stats -->
            <div class="grid grid-cols-2 gap-4">
                <div class="glass-panel rounded-xl border border-surface-variant p-4 flex flex-col items-center justify-center text-center shadow-sm">
                    <span class="material-symbols-outlined text-primary mb-1 text-3xl"
                          style="font-variation-settings: 'FILL' 1;">task_alt</span>
                    <span class="font-headline-md text-headline-md text-on-surface">@Model.CompletedJobsCount</span>
                    <span class="font-caption text-caption text-secondary">Jobs Completed</span>
                </div>
                <div class="glass-panel rounded-xl border border-surface-variant p-4 flex flex-col items-center justify-center text-center shadow-sm">
                    <span class="material-symbols-outlined text-amber-500 mb-1 text-3xl"
                          style="font-variation-settings: 'FILL' 1;">workspace_premium</span>
                    <span class="font-headline-md text-headline-md text-on-surface">@Model.Reviews.Count</span>
                    <span class="font-caption text-caption text-secondary text-xs">Total Reviews</span>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Portfolio Modal -->
<div id="portfolioModal" class="fixed inset-0 z-50 hidden" role="dialog">
    <div class="fixed inset-0 bg-black/50 backdrop-blur-sm"
         onclick="document.getElementById('portfolioModal').classList.add('hidden')"></div>
    <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
        <div class="flex min-h-full items-center justify-center p-4">
            <div class="relative bg-surface-container-lowest rounded-2xl shadow-2xl border border-surface-variant max-w-2xl w-full overflow-hidden">
                <div class="px-6 py-4 border-b border-surface-variant flex justify-between items-center">
                    <h3 class="font-headline-md text-lg font-bold text-on-surface" id="portfolioModalTitle"></h3>
                    <button onclick="document.getElementById('portfolioModal').classList.add('hidden')"
                            class="text-secondary hover:text-on-surface transition-colors">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>
                <div class="p-0">
                    <img id="portfolioModalImage" src="" alt=""
                         class="w-full max-h-96 object-contain bg-surface-container-low" />
                </div>
                <div class="px-6 py-4">
                    <p id="portfolioModalDesc" class="font-body-md text-sm text-secondary"></p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function openPortfolioModal(imageUrl, title, description) {
        document.getElementById('portfolioModalImage').src  = imageUrl || '';
        document.getElementById('portfolioModalTitle').innerText = title || '';
        document.getElementById('portfolioModalDesc').innerText  = description || '';
        document.getElementById('portfolioModal').classList.remove('hidden');
    }
</script>
