<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — FixConnect Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet text/css" />

    <style>
        /* إضافة تأثير خفيف عند التحويم فوق اللينكات */
        .nav-link {
            transition: color 0.2s ease-in-out;
            display: flex;
            align-items: center;
            gap: 6px; /* مسافة متناسقة بين الأيقونة والكتابة */
        }
    </style>
</head>
<body class="bg-light">

    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm mb-4 px-4">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold d-flex align-items-center" href="#">
                <img src="~/images/Osta Logo .png" style="width: 100px; height: 40px; object-fit: contain;" alt="logo" />
                <span class="badge bg-danger ms-2" style="font-size:0.6rem">Admin</span>
            </a>

            <div class="navbar-nav ms-auto gap-3 align-items-center">
                <a asp-controller="Admin" asp-action="Users"
                   class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Users" ? "text-primary fw-bold" : "text-secondary")">
                    <i class="bi bi-people-fill"></i> Users
                </a>

                <a asp-controller="Admin" asp-action="Requests"
                   class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Requests" ? "text-primary fw-bold" : "text-secondary")">
                    <i class="bi bi-file-earmark-text-fill"></i> Requests
                </a>

                <a asp-controller="Admin" asp-action="Proposals"
                   class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Proposals" ? "text-primary fw-bold" : "text-secondary")">
                    <i class="bi bi-briefcase-fill"></i> Proposals
                </a>

                <a asp-controller="Admin" asp-action="Jobs"
                   class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Jobs" ? "text-primary fw-bold" : "text-secondary")">
                    <i class="bi bi-tools"></i> Jobs
                </a>

                <a asp-controller="Admin" asp-action="Analytics"
                   class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Analytics" ? "text-primary fw-bold" : "text-secondary")">
                    <i class="bi bi-graph-up-arrow"></i> Analytics
                </a>

                <a asp-controller="Reports" asp-action="AdminIndex"
                   class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "AdminIndex" && ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "text-danger fw-bold" : "text-secondary")">
                    <i class="bi bi-exclamation-octagon-fill"></i> Reports
                </a>

                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline ms-2">
                    <button class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </button>
                </form>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>