<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — FixConnect Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">

    <nav class="navbar navbar-expand navbar-light bg-light shadow-sm mb-4 px-4">
        <a class="navbar-brand fw-bold" href="#">
            🔧 FixConnect <span class="badge bg-danger ms-1" style="font-size:0.6rem">Admin</span>
        </a>
        <div class="navbar-nav ms-auto gap-2">
            <a asp-controller="Admin" asp-action="Users"
               class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Users" ? "text-black fw-bold" : "text-secondary")">
                👥 Users
            </a>
            <a asp-controller="Admin" asp-action="Requests"
               class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Requests" ? "text-black fw-bold" : "text-secondary")">
                📋 Requests
            </a>
            <a asp-controller="Admin" asp-action="Proposals"
               class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Proposals" ? "text-black fw-bold" : "text-secondary")">
                📝 Proposals
            </a>
            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline ms-2">
                <button class="btn btn-sm btn-outline-danger">Logout</button>
            </form>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>