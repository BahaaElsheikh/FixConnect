<div class="d-flex">
    <nav class="d-flex flex-column flex-shrink-0 p-3 bg-white border-end shadow-sm" style="width: 250px; min-height: 100vh; position: fixed;">
        <a class="navbar-brand fw-bold mb-4 fs-4 text-center" href="#">FixConnect</a>

        <div class="nav nav-pills flex-column mb-auto gap-2">
            @{
                var action = ViewContext.RouteData.Values["action"]?.ToString();
            }

            <a asp-controller="Worker" asp-action="Dashboard"
               class="nav-link @(action == "Dashboard" ? "active bg-dark text-white" : "text-muted")">
                🏠 Job Feed
            </a>

            <a asp-controller="Worker" asp-action="DirectRequests"
               class="nav-link @(action == "DirectRequests" ? "active bg-dark text-white" : "text-muted")">
                📩 Direct Requests
            </a>

            <a asp-controller="Worker" asp-action="MyProposals"
               class="nav-link @(action == "MyProposals" ? "active bg-dark text-white" : "text-muted")">
                📝 My Proposals
            </a>

            <a asp-controller="Worker" asp-action="Jobs"
               class="nav-link @(action == "Jobs" ? "active bg-dark text-white" : "text-muted")">
                🔨 My Jobs
            </a>

            <a asp-controller="Worker" asp-action="Profile"
               class="nav-link @(action == "Profile" ? "active bg-dark text-white" : "text-muted")">
                👤 My Profile
            </a>

            <a asp-controller="Worker" asp-action="Wallet"
               class="nav-link @(action == "Wallet" ? "active bg-dark text-white" : "text-muted")">
                💰 My Wallet
            </a>
        </div>

        <hr>

        <form asp-controller="Account" asp-action="Logout" method="post" class="w-100">
            <button class="btn btn-outline-danger w-100">Logout</button>
        </form>
    </nav>

    <main style="margin-left: 250px; width: 100%; padding: 20px;">
    </main>
</div>