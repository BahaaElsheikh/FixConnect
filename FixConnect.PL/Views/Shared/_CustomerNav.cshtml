@{
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    // جلب موديل الـ Badges من الـ ViewBag وتأمين عدم وجود Null
    var badges = ViewBag.CustomerNotificationBadges as FixConnect.BLL.DTOs.CustomerNotificationBadgeViewModel;

    // هيلبر فانكشن لربط كلاسات الـ Bootstrap والـ Active state
    string GetNavClass(string targetAction)
    {
        return action == targetAction
            ? "d-flex align-items-center gap-3 px-4 py-3 text-primary bg-primary bg-opacity-10 fw-bold border-start border-4 border-primary rounded-end-3 text-decoration-none"
            : "d-flex align-items-center gap-3 px-4 py-3 text-secondary hover-sidebar rounded-3 text-decoration-none transition-all";
    }

    string GetIconFill(string targetAction)
    {
        return action == targetAction ? "font-variation-settings: 'FILL' 1;" : "";
    }
}

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
<style>
    .hover-sidebar:hover {
        background-color: var(--bs-gray-100) !important;
        color: var(--bs-primary) !important;
        transform: translateX(4px);
    }

    .transition-all {
        transition: all 0.2s ease-in-out;
    }
</style>

<nav class="d-md-none fixed-top w-100 d-flex justify-content-between align-items-center px-4 bg-white border-bottom shadow-sm" style="height: 64px; z-index: 1050;">
    <div class="d-flex align-items-center gap-3">
        <span class="material-symbols-outlined text-dark cursor-pointer">menu</span>
        <img src="~/images/Osta Logo .png" style="width: 120px; height: 80px;" alt="Osta Logo" />
    </div>
    <div class="d-flex align-items-center gap-3 text-primary position-relative">
        <div class="position-relative">
            <span class="material-symbols-outlined rounded-circle p-2 cursor-pointer">notifications</span>
            @{
                int totalBadges = (badges?.Requests ?? 0) + (badges?.ProposalsReceived ?? 0) + (badges?.Jobs ?? 0);
                if (totalBadges > 0)
                {
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 10px; padding: 0.35em 0.5em;">
                        @totalBadges
                    </span>
                }
            }
        </div>
        <img alt="Customer profile avatar" class="rounded-circle border" style="width: 32px; height: 32px; object-fit: cover;" src="~/uploads/ProfilePictures/default.png" />
    </div>
</nav>

<aside class="d-none d-md-flex flex-column bg-white border-end shadow-sm py-4 px-3 gap-3 z-40 position-fixed top-0 start-0 h-100" style="width: 310px; min-height: 100vh;">

    <div class="px-3 mb-2">
        <img src="~/images/Osta Logo .png" style="width: 160px; height: 100px;" alt="Osta Logo" />

        <div class="d-flex align-items-center gap-3 mt-4 bg-light p-3 rounded-3 border">
            <img alt="Customer profile picture" class="rounded-circle border" style="width: 40px; height: 40px; object-fit: cover;" src="~/uploads/ProfilePictures/default.png" />
            <div>
                <div class="small fw-bold text-dark">Customer Portal</div>
                <div class="text-primary d-flex align-items-center gap-1" style="font-size: 12px;">
                    <span class="material-symbols-outlined" style="font-size: 14px;">person_pin</span> Client Account
                </div>
            </div>
        </div>
    </div>

    <nav class="d-flex flex-column gap-1 flex-grow-1">
        <a asp-controller="Customer" asp-action="Index" class="@GetNavClass("Index")">
            <span class="material-symbols-outlined" style="@GetIconFill("Index")">search</span>
            <span>Find a Worker</span>
        </a>

        <a asp-controller="Customer" asp-action="MyRequests" class="@GetNavClass("MyRequests")">
            <span class="material-symbols-outlined" style="@GetIconFill("MyRequests")">chat_bubble</span>
            <span>My Requests</span>
            @if (badges != null && badges.Requests > 0)
            {
                <span class="badge rounded-pill bg-danger ms-auto px-2 py-1 small animate-pulse">
                    @badges.Requests
                </span>
            }
        </a>

        <a asp-controller="Customer" asp-action="ReceivedProposals" class="@GetNavClass("ReceivedProposals")">
            <span class="material-symbols-outlined" style="@GetIconFill("ReceivedProposals")">move_to_inbox</span>
            <span>Proposals Received</span>
            @if (badges != null && badges.ProposalsReceived > 0)
            {
                <span class="badge rounded-pill bg-danger ms-auto px-2 py-1 small">
                    @badges.ProposalsReceived
                </span>
            }
        </a>

        <a asp-controller="Customer" asp-action="Jobs" class="@GetNavClass("Jobs")">
            <span class="material-symbols-outlined" style="@GetIconFill("Jobs")">construction</span>
            <span>My Jobs</span>
            @if (badges != null && badges.Jobs > 0)
            {
                <span class="badge rounded-pill bg-danger ms-auto px-2 py-1 small">
                    @badges.Jobs
                </span>
            }
        </a>
    </nav>

    <div class="d-flex flex-column gap-1 pt-3 border-top mt-auto">
        <a href="#" class="d-flex align-items-center gap-3 px-4 py-2 text-secondary hover-sidebar rounded-3 text-decoration-none transition-all">
            <span class="material-symbols-outlined">help</span>
            <span>Support</span>
        </a>

        <form asp-controller="Account" asp-action="Logout" method="post" class="w-100 m-0 p-0">
            <button type="submit" class="w-100 d-flex align-items-center gap-3 px-4 py-2 btn btn-link text-secondary text-start text-decoration-none hover-sidebar rounded-3 border-0">
                <span class="material-symbols-outlined">logout</span>
                <span>Logout</span>
            </button>
        </form>
    </div>
</aside>

<div class="d-none d-md-block" style="width: 320px; shrink: 0;"></div>