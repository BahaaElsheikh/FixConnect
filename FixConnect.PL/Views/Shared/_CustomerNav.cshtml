<nav class="d-flex flex-column flex-shrink-0 p-3 bg-white border-end shadow-sm"
     style="width: 250px; min-height: 100vh; position: fixed; top: 0; left: 0; z-index: 100;">

    <a class="navbar-brand fw-bold mb-4 fs-4 text-center" href="#">FixConnect</a>

    <div class="nav nav-pills flex-column mb-auto gap-2">
        @{
            var action = ViewContext.RouteData.Values["action"]?.ToString();
        }
        <a asp-controller="Customer" asp-action="Index"
           class="nav-link @(action == "Index" ? "active bg-primary text-white" : "text-muted")">
            🔍 Find a Worker
        </a>
        <a asp-controller="Customer" asp-action="MyRequests"
           class="nav-link @(action == "MyRequests" ? "active bg-primary text-white" : "text-muted")">
            📋 My Requests
        </a>
        <a asp-controller="Customer" asp-action="ReceivedProposals"
           class="nav-link @(action == "ReceivedProposals" ? "active bg-primary text-white" : "text-muted")">
            📨 Proposals Received
        </a>
        <a asp-controller="Customer" asp-action="Jobs"
           class="nav-link @(action == "Jobs" ? "active bg-primary text-white" : "text-muted")">
            🔨 My Jobs
        </a>
    </div>

    <hr />

    <form asp-controller="Account" asp-action="Logout" method="post" class="w-100">
        <button class="btn btn-outline-danger w-100">Logout</button>
    </form>

</nav>
